{
  "schema": "q4r3_team_advisor_canonical_truth_ssot_v1",
  "version": "1.1.0",
  "canonical_name_policy": {
    "display_names": {
      "lbot": "LBot",
      "mbot": "MBot",
      "obot": "OBot",
      "sbot": "SBot",
      "alpha_team": "AlphaTeam",
      "beta_team": "BetaTeam",
      "gamma_team": "GammaTeam",
      "delta_team": "DeltaTeam",
      "zbot": "ZBot",
      "zico": "Zico",
      "lico": "Lico",
      "zlice": "Zlice"
    },
    "accepted_legacy_aliases": {
      "Zico": ["ZICO", "zico"],
      "Lico": ["LiCo", "LICO", "lico"]
    },
    "output_rule": "All human-readable reports and contracts must emit Zico and Lico. Legacy aliases are accepted only as discovery inputs."
  },
  "scope": [
    "LBot",
    "MBot",
    "OBot",
    "SBot",
    "AlphaTeam",
    "BetaTeam",
    "GammaTeam",
    "DeltaTeam",
    "ZBot",
    "Zico",
    "Lico",
    "Zlice"
  ],
  "classifications": [
    "KEEP",
    "ABSORB",
    "RESERVE",
    "QUARANTINE",
    "ARCHIVE"
  ],
  "owner_kinds": [
    "runtime_core",
    "package_core",
    "adapter",
    "api_surface",
    "contract",
    "configuration",
    "service_wrapper",
    "ui_consumer",
    "test_support"
  ],
  "required_owner_fields": [
    "component",
    "canonical_path",
    "owner_kind",
    "sha256",
    "contract_version",
    "runtime_binding",
    "git_commit",
    "classification",
    "classification_reason"
  ],
  "required_runtime_mapping": [
    "unit",
    "fragment_path",
    "exec_start",
    "resolved_exec_path",
    "resolved_script_paths",
    "symlink_chain",
    "wrapper_chain",
    "active_state"
  ],
  "zbot_required_policy_surfaces": [
    "provider_router",
    "openai_adapter",
    "gemini_adapter",
    "model_alias_registry",
    "prompt_version_registry",
    "structured_input_schema",
    "structured_output_schema",
    "call_gate_policy",
    "budget_policy",
    "fallback_policy",
    "circuit_breaker_policy",
    "evidence_sink",
    "ablation_policy"
  ],
  "zico_required_surfaces": [
    "state_machine",
    "idempotency",
    "causal_ordering",
    "permission_gate",
    "owner_lease",
    "timeout_policy",
    "compensation_policy",
    "invariant_engine",
    "replay"
  ],
  "lico_required_surfaces": [
    "source_registry",
    "freshness_policy",
    "source_consensus",
    "execution_cost_model",
    "venue_health",
    "stress_scenarios",
    "team_context"
  ],
  "candidate_rules": {
    "do_not_use_role_words_as_identity": true,
    "resolve_systemd_wants_symlinks": true,
    "resolve_execstart_interpreters_to_script": true,
    "resolve_shell_and_python_wrapper_chains": true,
    "package_owner_allowed": true,
    "filename_snapshot_is_not_contamination_by_itself": true,
    "exclude_contamination_directories": true,
    "require_runtime_or_exact_identity_evidence": true
  },
  "non_negotiable_policy": {
    "observer_only": true,
    "paper_enabled": false,
    "live_enabled": false,
    "order_enabled": false,
    "order_authority": "blocked",
    "execution_authority": "none",
    "historical_backfill_allowed": false,
    "automatic_binding_allowed": false,
    "automatic_promotion_allowed": false
  },
  "exit_gate": {
    "canonical_owner_count": 12,
    "duplicate_owner_count": 0,
    "unclassified_runtime_candidate_count": 0,
    "active_exec_mapping_pct": 100,
    "unresolved_symlink_count": 0,
    "unresolved_wrapper_count": 0,
    "canonical_name_violation_count": 0
  }
}
