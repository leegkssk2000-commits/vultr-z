{
  "schema": "q4r3_team_advisor_sgrade_readiness_ssot_v1",
  "version": "1.0.0",
  "status": "ACTIVE_FOR_READINESS_AUDIT_ONLY",
  "scope": [
    "LBot",
    "MBot",
    "OBot",
    "SBot",
    "AlphaTeam",
    "BetaTeam",
    "GammaTeam",
    "DeltaTeam",
    "ZBot",
    "ZICO",
    "LiCo",
    "Zlice"
  ],
  "non_negotiable_policy": {
    "observer_only": true,
    "paper_enabled": false,
    "live_enabled": false,
    "order_enabled": false,
    "order_authority": "blocked",
    "execution_authority": "none",
    "historical_backfill_allowed": false,
    "automatic_promotion_allowed": false
  },
  "role_contracts": {
    "LBot": {
      "role": "lead_trend_candidate_and_hold_reduce_posture",
      "required_signals": ["trend", "primary_candidate", "hold_or_reduce", "confidence", "reason_codes"]
    },
    "MBot": {
      "role": "method_range_confirmation_and_helper_reduce_logic",
      "required_signals": ["method_fit", "range_context", "confirmation", "reduce_context", "confidence", "reason_codes"]
    },
    "OBot": {
      "role": "breakout_observer_and_anomaly_watch",
      "required_signals": ["breakout_state", "observation", "anomaly", "confidence", "reason_codes"]
    },
    "SBot": {
      "role": "safety_guard_and_veto",
      "required_signals": ["risk_state", "veto", "abstain", "stale_guard", "confidence", "reason_codes"]
    },
    "ZBot": {
      "role": "advisor_decision_trace_only_not_team_bot",
      "required_signals": ["advice", "alternatives", "counterfactual", "confidence", "reason_codes"]
    },
    "ZICO": {
      "role": "intent_and_lifecycle_context_control_without_trade_authority",
      "required_signals": ["intent_state", "lifecycle_state", "control_context", "confidence", "reason_codes"]
    },
    "LiCo": {
      "role": "liquidity_macro_fx_context_without_trade_authority",
      "required_signals": ["liquidity", "macro", "fx", "freshness", "confidence", "reason_codes"]
    },
    "Zlice": {
      "role": "evidence_and_lifecycle_trace_without_trade_authority",
      "required_signals": ["evidence_lineage", "lifecycle_trace", "source_ids", "confidence", "reason_codes"]
    },
    "TeamLane": {
      "role": "weighted_lmos_vote_aggregation_with_abstain_veto_and_trace",
      "required_signals": ["team_id", "member_votes", "weights", "abstain", "veto", "final_vote", "confidence", "reason_codes"]
    }
  },
  "required_lineage_fields": [
    "position_id",
    "symbol",
    "side",
    "strategy_id",
    "method_id",
    "skill_id",
    "event_ts",
    "source_ids",
    "contract_version"
  ],
  "required_contract_capabilities": [
    "typed_input_contract",
    "typed_output_contract",
    "unique_canonical_owner",
    "owner_sha_or_version",
    "deterministic_reason_codes",
    "confidence_and_abstain",
    "stale_and_missing_input_policy",
    "latency_and_freshness_output",
    "failure_isolation",
    "status_and_violation_output",
    "counterfactual_or_ablation_trace",
    "no_private_execution_authority",
    "unit_contract_failure_tests"
  ],
  "readiness_levels": {
    "S0_STRUCTURE_READY": {
      "required": [
        "all_contract_capabilities_present",
        "all_lineage_fields_present",
        "unique_owner_confirmed",
        "authority_lock_confirmed",
        "critical_gap_count_zero"
      ]
    },
    "S1_FORWARD_INTEGRITY": {
      "minimum_new_close_count": 20,
      "lineage_coverage_pct": 100.0,
      "duplicate_count": 0,
      "missing_required_field_count": 0,
      "stale_accept_count": 0
    },
    "S2_COMPONENT_EFFICACY": {
      "minimum_new_close_count": 100,
      "requires_component_ablation": true,
      "requires_counterfactual": true,
      "requires_performance_threshold_ssot": true,
      "claim_allowed_without_threshold_ssot": false
    },
    "S3_INTEGRATED_S_GRADE": {
      "minimum_new_close_count": 300,
      "requires_strategy_method_skill_team_advisor_full_lineage": true,
      "requires_component_and_combo_ablation": true,
      "requires_cost_latency_dd_exposure_penalty": true,
      "requires_no_regression_against_frozen_raw_baseline": true,
      "automatic_promotion_allowed": false
    }
  },
  "decision": {
    "current_s_grade_claim_allowed": false,
    "reason": "S-grade requires canonical ownership, contract completeness, forward integrity and efficacy evidence; file presence or ALIMI display is insufficient.",
    "action": "hold"
  }
}
