{
  "schema": "zos_exact25_r73a_source_entry_bridge_v1",
  "version": "1.0.0-candidate.1",
  "official_stage": "R7.3A",
  "status": "CANDIDATE_PREBIND_ONLY",
  "purpose": "Validate a deterministic read-only bridge from one canonical Exact25 source-entry event to four isolated R7.2 exit-lane events before runtime subscription.",
  "authority": {
    "observer_only": true,
    "runtime_binding_allowed": false,
    "source_event_subscription_allowed": false,
    "source_ack_allowed": false,
    "projection_state_write_allowed": false,
    "producer_mutation_allowed": false,
    "writer_mutation_allowed": false,
    "formal_ledger_mutation_allowed": false,
    "strategy_mutation_allowed": false,
    "skill_registry_mutation_allowed": false,
    "provider_invocation_enabled": false,
    "network_call_enabled": false,
    "paper_enabled": false,
    "live_enabled": false,
    "order_enabled": false,
    "order_authority": "blocked",
    "execution_authority": "none",
    "automatic_promotion_enabled": false
  },
  "dependencies": {
    "r72_state_required": "PASS",
    "projection_state_required": "PROJECTION_READY",
    "strategy_count": 25,
    "exit_policy_count": 4,
    "lane_template_count": 100,
    "source_event_count_per_bridge_call": 1,
    "lane_event_count_per_source_event": 4,
    "raw_skill_set_required": [],
    "r64_external_canary_required": false
  },
  "required_source_entry_fields": [
    "source_event_id",
    "source_position_id",
    "source_sequence",
    "strategy_id",
    "strategy_source_sha256",
    "method_id",
    "symbol",
    "side",
    "entry_ts_ms",
    "observed_at_ms",
    "entry_price",
    "market_path_id",
    "cost_model_ref",
    "source_ref"
  ],
  "bridge_rules": {
    "canonical_source_event_required": true,
    "source_event_identity_immutable": true,
    "source_position_identity_immutable": true,
    "same_source_entry_across_four_lanes": true,
    "same_market_path_across_four_lanes": true,
    "same_cost_model_across_four_lanes": true,
    "exactly_four_exit_lanes_required": true,
    "independent_lane_event_id_required": true,
    "independent_lane_position_id_required": true,
    "independent_state_namespace_required": true,
    "independent_cooldown_namespace_required": true,
    "raw_skill_contamination_forbidden": true,
    "cross_lane_state_sharing_forbidden": true,
    "cross_lane_ack_sharing_forbidden": true,
    "source_event_ack_forbidden_in_prebind": true,
    "completed_bar_only_when_bar_features_required": true,
    "same_bar_stop_target_ambiguity": "score_conservatively_as_stop"
  },
  "integrity_rules": {
    "allowed_sides": ["long", "short"],
    "minimum_entry_price_exclusive": 0,
    "minimum_source_sequence": 0,
    "maximum_future_skew_ms": 5000,
    "maximum_entry_to_observed_lag_ms": 300000,
    "strategy_digest_prefix": "sha256:",
    "source_ref_prefixes": ["cf:", "sheets:", "runtime:"],
    "missing_or_invalid_action": "HOLD"
  },
  "required_lane_event_fields": [
    "bridge_epoch_id",
    "source_event_id",
    "source_position_id",
    "source_sequence",
    "lane_event_id",
    "lane_position_id",
    "lane_template_id",
    "strategy_id",
    "method_id",
    "exit_policy_id",
    "symbol",
    "side",
    "entry_ts_ms",
    "entry_price",
    "market_path_id",
    "cost_model_ref",
    "skill_set",
    "state_namespace",
    "cooldown_namespace",
    "observer_only",
    "execution_authority",
    "order_authority"
  ],
  "next_stage": "R7.3B_ZERO_TO_ONE_C_SIDECAR_SMOKE"
}
