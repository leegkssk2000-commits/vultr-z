{
  "schema_version": "zel.a1_g14_profit_track.p0_p7.v1",
  "state": "BOUND_RESEARCH_ONLY",
  "purpose": "Insert a profitability-improvement track inside the canonical A1->G14 research roadmap without creating a second roadmap or changing the meaning of A1->G14 stages.",
  "integration": {
    "canonical_roadmap": "A1_TO_G14",
    "parallel_roadmap": false,
    "profit_track_is_stage_internal": true,
    "canonical_stage_semantics_unchanged": true,
    "canonical_gate_thresholds_override_this_contract": true,
    "new_ai_ui_infrastructure_freeze_until_material_economic_improvement": true,
    "fresh_oos_collection_continues_in_parallel": true,
    "fresh_wait_blocks_dev_search": false
  },
  "stage_bindings": [
    {
      "canonical_stage": "A1",
      "profit_phases": ["P0", "P1", "P2", "P3"],
      "exit_condition": "ECONOMIC_WINNER_OR_CANONICAL_A1_TERMINAL"
    },
    {
      "canonical_stage": "A2",
      "profit_phases": ["P2", "P3", "P4"],
      "exit_condition": "CANONICAL_A2_PASS"
    },
    {
      "canonical_stage": "A3",
      "profit_phases": ["P4"],
      "exit_condition": "CANONICAL_A3_SURVIVOR"
    },
    {
      "canonical_stage": "A3_TO_G5",
      "profit_phases": ["P2", "P3", "P4"],
      "mode": "CUMULATIVE_ON_CURRENT_SURVIVOR",
      "restart_from_zero_forbidden": true
    },
    {
      "canonical_stage": "G5_G5S",
      "profit_phases": ["P5"]
    },
    {
      "canonical_stage": "POST_G5S",
      "profit_phases": ["P6"]
    },
    {
      "canonical_stage": "PRE_PAPER",
      "profit_phases": ["P7"]
    },
    {
      "canonical_stage": "POST_P7",
      "profit_phases": [],
      "next": "RESUME_EXISTING_G6_TO_G14_RULES"
    }
  ],
  "phases": {
    "P0": {
      "name": "INFRA_FREEZE",
      "objective": "Stop nonessential AI/UI/infrastructure expansion while profitability remains the bottleneck.",
      "allowed": [
        "source_integrity_repairs",
        "canonical_lineage_repairs",
        "research_gate_repairs",
        "authority_safety_repairs"
      ],
      "blocked": [
        "new_nonessential_ai_surface",
        "new_nonessential_ui_surface",
        "unrelated_infrastructure_expansion"
      ]
    },
    "P1": {
      "name": "ECONOMIC_TRUTH_TABLE_25_WIDE",
      "objective": "Re-evaluate the 25-strategy universe under comparable economic conditions before further search.",
      "required_metrics": [
        "completed_trades",
        "win_rate",
        "net_pnl_after_costs",
        "net_expectancy",
        "profit_factor",
        "max_drawdown",
        "sample_retention",
        "realized_cost"
      ],
      "same_cost_model_required": true,
      "same_evidence_comparison_required": true,
      "output": "25_WIDE_ECONOMIC_TRUTH_TABLE"
    },
    "P2": {
      "name": "DEV_SEARCH_V2",
      "objective": "Search distinct causal axes quickly while preserving exact-parent comparability and without waiting for fresh/OOS collection.",
      "comparison_contract": {
        "same_strategy": true,
        "exact_parent": true,
        "same_cost_model": true,
        "one_primary_axis_per_child": true,
        "post_outcome_threshold_fitting": false,
        "same_evidence_retune": false
      },
      "dev_min_completed_trades": "max(8, ceil(parent_completed_trades * 0.60))",
      "dev_gate_scope_only": true,
      "canonical_a2_a3_fresh_oos_thresholds_unchanged": true,
      "parallel_distinct_axis_search": {
        "enabled": true,
        "preferred_width": "2_TO_3_WHEN_RESOURCES_ALLOW",
        "shared_parent_required": true,
        "shared_cost_model_required": true
      },
      "winner_count_per_parent": 1
    },
    "P3": {
      "name": "FAST_KILL_FAILOVER",
      "objective": "Kill non-economic children early and rotate to the next preregistered distinct axis.",
      "economic_upgrade_gate": {
        "net_pnl_after_costs": "STRICTLY_IMPROVES",
        "net_expectancy": "STRICTLY_IMPROVES",
        "profit_factor": "NONWORSE",
        "max_drawdown": "NONWORSE",
        "winner_retention": "MUST_PASS_EXISTING_SSOT_OR_STAGE_CONTRACT"
      },
      "technical_failure_counts_as_economic_failure": false,
      "integrity_failure_counts_as_economic_failure": false,
      "consecutive_distinct_axis_economic_failures_before_demotion": 2,
      "demotion": "ACTIVE_TO_CHALLENGER",
      "failover": "NEXT_PREREGISTERED_DISTINCT_AXIS"
    },
    "P4": {
      "name": "MATURITY_FRESH_CAUSAL",
      "objective": "Carry economic winners through the existing A2 cost/maturity/walk-forward/OOS gates and A3 prospective causal durability gates.",
      "a2": [
        "cost_maturity",
        "walk_forward",
        "oos"
      ],
      "a3": [
        "prospective_fresh_causal",
        "durability",
        "fragility_controls"
      ],
      "operating_fresh_completed_trade_target": "25_TO_50_WHEN_APPLICABLE",
      "canonical_minimums_source": "EXISTING_A1_A2_A3_CONTRACTS",
      "survivor_target_before_portfolio_synthesis": "3_TO_5_CORE_SURVIVORS"
    },
    "P5": {
      "name": "PORTFOLIO_SYNTHESIS",
      "objective": "Classify the full strategy universe and synthesize only economically viable survivors.",
      "classification": [
        "CORE",
        "SYNTHESIS_MATERIAL",
        "HOLD",
        "REJECT"
      ],
      "core_target_count": "3_TO_5",
      "core_requires_independent_economic_viability": true,
      "tests": [
        "strategy_correlation",
        "duplicate_exposure",
        "leave_one_strategy_out",
        "signal_conflict",
        "joint_drawdown"
      ]
    },
    "P6": {
      "name": "REGIME_PORTFOLIO_ALLOCATOR",
      "objective": "Route independently viable CORE strategies by regime and portfolio interaction.",
      "default_when_conflicted_or_unknown": "NO_TRADE",
      "entry_time_features_only": true,
      "silent_signal_merge_forbidden": true,
      "required_outputs": [
        "regime_route",
        "allocation",
        "conflict_resolution",
        "joint_risk"
      ]
    },
    "P7": {
      "name": "PAPER_CANARY_30D",
      "objective": "Run the synthesized portfolio through the canonical 30-day paper canary before later G-stage live-readiness work.",
      "duration_days": 30,
      "required_observation": [
        "net_pnl_after_costs",
        "win_rate",
        "expectancy",
        "profit_factor",
        "drawdown",
        "exposure",
        "slippage",
        "funding",
        "route_integrity"
      ],
      "pass_next": "RESUME_EXISTING_G6_TO_G14_RULES"
    }
  },
  "distinct_axis_queues": {
    "break_and_continue": {
      "terminal_predecessor": "TRADE_FLOW_REL_VOLUME_CONFIRMATION_ONLY=NO_EFFECT",
      "queue": [
        {
          "axis": "BREAKOUT_PERSISTENCE_OWNER_ONLY",
          "guard": "SAME_DECISION_TIMESTAMP_CAUSAL_DEFINITION_REQUIRED",
          "if_guard_fails": "SKIP_WITHOUT_ECONOMIC_FAIL_COUNT"
        },
        {
          "axis": "OHLCV_ACTIVITY_LIQUIDITY_PROXY_OWNER_ONLY",
          "interpretation": "ACTIVITY_LIQUIDITY_PROXY_NOT_NATIVE_L2"
        },
        {
          "axis": "LIQUIDITY_REGIME_OWNER_ONLY",
          "guard": "ENTRY_TIME_ONLY_AND_SOURCE_GRANULARITY_VALID"
        }
      ]
    },
    "supertrend_pullback": {
      "queue": [
        "TREND_PERSISTENCE_OWNER_ONLY",
        "VOLATILITY_REGIME_OWNER_ONLY",
        "EXIT_TRAILING_OWNER_ONLY"
      ]
    },
    "trend_ma_macd": {
      "queue": [
        "REDUNDANT_COMPONENT_ABLATION_ONLY",
        "MULTISPEED_TREND_OWNER_ONLY",
        "VOLATILITY_REGIME_OWNER_ONLY"
      ]
    },
    "keltner_trend": {
      "queue": [
        "BAND_EXPANSION_TRANSITION_ONLY",
        "VOLATILITY_COOL_LOSS_REPAIR_ONLY"
      ]
    },
    "trend_rider": {
      "queue": [
        "MULTISPEED_TREND_OWNER_ONLY"
      ]
    }
  },
  "non_regression": {
    "incumbent_advances_only_after_reproducible_pass": true,
    "restart_from_original_after_pass": false,
    "failed_child_never_replaces_parent": true,
    "fresh_oos_never_reused_for_selection": true,
    "future_information_forbidden": true,
    "threshold_sweep_without_preregistration_forbidden": true,
    "technical_or_provider_failure_is_not_economic_failure": true,
    "terminal_same_identity_retry_forbidden": true
  },
  "authority": {
    "research_only": true,
    "canonical_runtime_mutation": false,
    "shadow_mutation": false,
    "paper_mutation": false,
    "live_mutation": false,
    "registry_mutation": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "live_trade_authority": "BLOCKED"
  }
}
