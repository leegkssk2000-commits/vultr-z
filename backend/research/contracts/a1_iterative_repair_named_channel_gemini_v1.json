{
  "schema_version": "zel.a1.iterative_repair_named_channel_gemini.v1",
  "state": "BOUND_RESEARCH_ONLY",
  "purpose": "Continue second/third-generation repair for economically improved but Pareto-ambiguous children, while continuously mining the user-selected YouTube channels with Gemini for reproducible mechanisms that can be mapped into the 25-strategy research/rebuild program.",
  "binds_to": [
    "backend/research/contracts/a1_g14_profit_track_p0_p7_v1.json",
    "backend/research/contracts/a1_strategy25_triage_external_evidence_v1.json",
    "backend/research/rebuild/a1_common_regime_selector_pareto_latest.json",
    "backend/research/rebuild/a1_break_box_loss_streak_regression_latest.json"
  ],
  "iterative_pareto_repair": {
    "enabled": true,
    "scope": "DEVELOPMENT_RESEARCH_ONLY",
    "qualifier": {
      "economic_improvement_required": [
        "net_pnl_bps",
        "net_expectancy_bps"
      ],
      "at_least_one_of": [
        "win_rate",
        "profit_factor",
        "payoff",
        "winner_retention"
      ],
      "ambiguous_worsening_allowlist": [
        "drawdown_bps",
        "max_drawdown_bps",
        "realized_exit_bucket_max_drawdown_bps",
        "common_mode_exposure",
        "loss_streak"
      ],
      "nonrisk_economic_regression_action": "DO_NOT_CALL_AMBIGUOUS_IMPROVEMENT; RETURN_TO_DISTINCT_AXIS_FAILOVER"
    },
    "incumbent_policy": {
      "best_partial_success_is_preserved": true,
      "ambiguous_child_never_overwrites_parent_or_incumbent": true,
      "failed_later_generation_never_resets_prior_progress": true,
      "restart_from_zero_forbidden": true
    },
    "generations": [
      {
        "id": "R2",
        "name": "DD_ROOT_CAUSE_ATTRIBUTION",
        "mutation_allowed": false,
        "required_breakdowns": [
          "peak_to_trough_trade_path",
          "new_trades_vs_exact_parent",
          "symbol",
          "side",
          "session",
          "exit_reason",
          "loss_streak",
          "largest_loss",
          "same_timestamp_common_mode",
          "same_symbol_overlap",
          "winner_retention",
          "cost_drag"
        ],
        "output": "ONE_OR_MORE_PREENTRY_CAUSAL_REPAIR_HYPOTHESES"
      },
      {
        "id": "R3",
        "name": "ONE_AXIS_DD_REPAIR",
        "mutation_allowed": "RESEARCH_CHILD_ONLY",
        "allowed_axes": [
          "COMMON_MODE_EXPOSURE_CONTEXT_ONLY",
          "SAME_SYMBOL_OVERLAP_CONTEXT_ONLY",
          "SESSION_REGIME_OWNER_ONLY",
          "SIDE_REGIME_OWNER_ONLY",
          "VOLATILITY_REGIME_OWNER_ONLY",
          "ENTRY_CHASE_CONTEXT_ONLY",
          "EXIT_TRAILING_OWNER_ONLY",
          "LOSS_CAP_EXIT_OWNER_ONLY"
        ],
        "rules": [
          "choose_axis_from_R2_attribution_not_from_threshold_sweep",
          "one_primary_axis_per_child",
          "exact_parent_same_cost_same_boundary_comparison",
          "post_outcome_trade_deletion_forbidden",
          "creator_threshold_import_forbidden",
          "future_information_forbidden"
        ],
        "upgrade_gate": {
          "net_pnl_bps": "NONWORSE_VS_BEST_PARTIAL_SUCCESS",
          "net_expectancy_bps": "NONWORSE_VS_BEST_PARTIAL_SUCCESS",
          "profit_factor": "NONWORSE_WHEN_AVAILABLE",
          "winner_retention": "NONWORSE_WHEN_AVAILABLE",
          "drawdown": "STRICTLY_IMPROVES_VS_BEST_PARTIAL_SUCCESS",
          "integrity": "PASS"
        }
      }
    ],
    "continue_after_R3": {
      "enabled": true,
      "rule": "IF_CHILD_REMAINS_DD_ONLY_TRADEOFF_REPEAT_DISTINCT_ONE_AXIS_REPAIR_AS_R4_RN; STOP_AT_STRICT_PARETO_OR_TWO_CONSECUTIVE_DISTINCT_AXIS_ECONOMIC_FAILURES",
      "strict_pareto_target": "NO_WORSENED_ECONOMIC_OR_RISK_METRICS",
      "fresh_oos_required_before_any_promotion": true
    },
    "current_priority": [
      {
        "strategy_id": "break_and_continue",
        "candidate_id": "break_and_continue_box_break_child_v1",
        "reason": "PnL/expectancy/win-rate improved while drawdown worsened; preserve the child and repair the risk path rather than discarding the economic improvement.",
        "next": "R2_DD_ROOT_CAUSE_ATTRIBUTION_THEN_R3_ONE_AXIS_REPAIR"
      }
    ]
  },
  "named_youtube_gemini": {
    "enabled": true,
    "mode": "PERSISTENT_SEQUENTIAL_BEST_EFFORT_EXHAUSTIVE",
    "channels": [
      {"display_name": "차트고릴라", "aliases": ["차트고릴라"]},
      {"display_name": "김직선", "aliases": ["김직선"]},
      {"display_name": "골드핑거", "aliases": ["골드핑거"]},
      {"display_name": "Data Trader", "aliases": ["Data Trader", "data trader"]},
      {"display_name": "Ross Cameron", "aliases": ["Ross Cameron", "Warrior Trading Ross Cameron"]},
      {"display_name": "Trade Prime", "aliases": ["Trade Prime", "trade prime"]},
      {"display_name": "Trading Notes", "aliases": ["Trading Notes", "trading notes"]},
      {"display_name": "Neeraj Joshi", "aliases": ["Neeraj Joshi", "neeraj joshi"]},
      {"display_name": "Trader DNA", "aliases": ["Trader DNA", "trader dna"]}
    ],
    "discovery": {
      "channel_identity_must_be_resolved_before_video_acceptance": true,
      "exact_public_youtube_watch_url_required": true,
      "invented_url_forbidden": true,
      "shorts_default": "EXCLUDE",
      "livestream_default": "EXCLUDE_UNLESS_TECHNICALLY_RELEVANT_AND_DIRECT_ANALYSIS_WORKS",
      "target": "ALL_DISCOVERABLE_PUBLIC_LONG_FORM_VIDEOS",
      "truthfulness": "DO_NOT_CLAIM_ALL_VIDEOS_COMPLETE_UNLESS_FULL_CHANNEL_INVENTORY_IS_VERIFIABLY_ENUMERATED",
      "saturation_state": "DISCOVERY_SATURATED_NOT_PROVEN_EXHAUSTIVE",
      "newest_first": true,
      "round_robin_across_channels": true,
      "view_count": "DISCOVERY_PRIORITY_ONLY_NOT_EVIDENCE_AUTHORITY"
    },
    "gemini_direct_video_extract": [
      "concise_video_summary",
      "creator_claims",
      "reproducible_mechanisms",
      "market_and_timeframe_context",
      "regime_conditions",
      "entry_time_features",
      "entry_logic",
      "exit_logic",
      "stop_and_trailing_logic",
      "risk_and_drawdown_control",
      "position_or_exposure_logic",
      "failure_modes",
      "data_requirements",
      "creator_numeric_thresholds_as_unverified_claims",
      "marketing_or_nonreproducible_claims",
      "local_test_needed",
      "candidate_strategy_mappings"
    ],
    "copyright_policy": {
      "full_transcript_storage": false,
      "long_verbatim_quotes": false,
      "store_summary_and_mechanism_only": true
    },
    "crosscheck": {
      "when_practical_require_one_independent_noncreator_source_before_expensive_rebuild": true,
      "sources": [
        "peer_reviewed_journal",
        "arxiv_or_ssrn",
        "exchange_primary_documentation",
        "university_or_research_institute",
        "reputable_quant_research"
      ],
      "paper_or_video_support_alone_never_passes_strategy": true
    },
    "strategy_application": {
      "KEEP_ACCUMULATE": "PARALLEL_HYPOTHESIS_ONLY_DO_NOT_MUTATE_INCUMBENT",
      "DIAGNOSE_REPAIR": "USE_MATCHED_MECHANISMS_ONLY_AS_ONE_AXIS_REPAIR_CANDIDATES_AFTER_LOCAL_ATTRIBUTION",
      "FULL_REBUILD": "USE_DISTINCT_MATCHED_MECHANISMS_TO_BUILD_NEW_V2_V3_ARCHITECTURE_CHILDREN",
      "MECHANISM_REBUILD": "USE_EXTERNAL_MECHANISMS_TO_REDISCOVER_EVENT_GENERATING_SIGNAL",
      "ZERO_EVENT_REBUILD": "PRIORITIZE_SIGNAL_GENERATION_AND_ADMISSION_MECHANISMS"
    }
  },
  "authority": {
    "research_only": true,
    "canonical_runtime_mutation": false,
    "shadow_mutation": false,
    "paper_mutation": false,
    "live_mutation": false,
    "registry_mutation": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "live_trade_authority": "BLOCKED"
  }
}
