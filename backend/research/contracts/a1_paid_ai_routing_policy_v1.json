{
  "schema_version": "zel.a1.paid_ai_routing_policy.v1",
  "state": "PAID_AI_ROI_GATED_ROUTING_FROZEN",
  "purpose": "Prevent recurring high-cost provider fanout and require every paid-AI output to contribute to an active G4/G5 economic gate instead of creating unrelated generic research.",
  "providers": {
    "gemini": {
      "default_role": "ESCALATION_ONLY_CAUSAL_RESEARCH_OR_INFORMATION_BRIDGE",
      "broad_sweep_allowed": false,
      "automatic_repeated_multicritic_allowed": false,
      "allowed_when": [
        "LOWER_COST_LANES_FAILED_OR_MISSING_REQUIRED_CAPABILITY",
        "BOUNDED_G4_OR_G5_CAUSAL_REPAIR",
        "NAMED_EXTERNAL_INFORMATION_TO_EXECUTABLE_G4_OR_G5_HYPOTHESIS_BRIDGE",
        "MANUAL_G4_OR_G5_DEEP_REVIEW"
      ]
    },
    "openai": {
      "default_role": "ESCALATION_ONLY_G4_G5_BUILDER_OR_FINAL_CRITIC",
      "broad_sweep_allowed": false,
      "automatic_repeated_multicritic_allowed": false,
      "allowed_when": [
        "LOWER_COST_LANES_FAILED_OR_MISSING_REQUIRED_CAPABILITY",
        "BOUNDED_G4_OR_G5_CAUSAL_REPAIR",
        "STRUCTURED_EXECUTABLE_G4_OR_G5_BUILDER",
        "FINAL_G4_OR_G5_ADVERSARIAL_CRITIC",
        "MANUAL_G4_OR_G5_DEEP_REVIEW"
      ]
    },
    "groq": {
      "default_role": "FIRST_PASS_G4_G5_DISCOVERY_AND_RED_TEAM",
      "paid_cost_class_assumed": false
    },
    "workers_ai": {
      "default_role": "FIRST_PASS_G4_G5_REVIEW_AND_DEDUP_GUARD",
      "paid_cost_class_assumed": false
    }
  },
  "mandatory_controls": {
    "input_signature_cache": true,
    "identical_input_paid_recall": false,
    "cosine_dedup_threshold": 0.85,
    "structured_output_required_when_supported": true,
    "provider_model_lineage_required": true,
    "request_count_required": true,
    "token_usage_required_when_provider_exposes_it": true,
    "economic_pass_attribution_required_for_roi_claim": true,
    "canonical_adoption_attribution_required_for_recovered_spend_claim": true,
    "fresh_sample_wait_triggers_paid_ai": false,
    "target_lane_id_required_before_provider_call": true,
    "target_stage_required_before_provider_call": true,
    "allowed_target_stages": ["G4", "G5", "G4_CAUSAL_BACKPORT_FROM_G5"],
    "target_gate_required_before_provider_call": true,
    "generic_unbound_NEW_candidate_success_forbidden": true,
    "paid_ai_credit_requires_g4_or_g5_gate_progress": true,
    "development_economic_pass_without_g4_g5_binding_is_roi_credit": false,
    "temporal_holdout_without_stage_binding_is_roi_credit": false
