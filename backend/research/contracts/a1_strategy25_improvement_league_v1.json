{
  "schema_version": "zel.a1.strategy25_improvement_league_contract.v1",
  "research_only": true,
  "goal": "maximize economic improvement throughput across the canonical 25-strategy set without relaxing strict certification gates",
  "authority": {
    "inventory": "backend/research/rebuild/strategy25_structural_inventory_v2.json",
    "baseline_ledger": "backend/research/rebuild/a1_exact25_disposition_ledger_v1.json",
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "live_trade_authority": "BLOCKED",
    "protected_mutations": 0
  },
  "roles": {
    "active_top5": 5,
    "challenger_next5": 5,
    "remainder": 15
  },
  "no_idle": {
    "no_completed_trade_growth_hours": 12,
    "estimated_hours_to_12_trades_failover": 168,
    "target_completed_trades_for_profit_cert_progress": 12,
    "first_run_never_forces_failover": true
  },
  "ranking": {
    "mode": "DETERMINISTIC_LEXICOGRAPHIC_ECONOMIC_FIRST",
    "order": [
      "stage_rank_desc",
      "positive_economics_desc",
      "completed_trades_desc",
      "net_expectancy_bps_desc",
      "net_pnl_bps_desc",
      "profit_factor_desc",
      "drawdown_bps_asc",
      "strategy_id_asc"
    ],
    "zero_trade_fresh_receipt_must_not_erase_positive_baseline_evidence": true,
    "retrospective_discovery_counterfactual_never_promotes": true
  },
  "improvement": {
    "pareto_only": true,
    "critical_metrics": [
      "completed_trades",
      "win_rate",
      "net_pnl_bps",
      "net_expectancy_bps",
      "profit_factor",
      "drawdown_bps",
      "pnl_dd"
    ],
    "numeric_threshold_sweep": false,
    "strict_h4_h5_a2_a3_threshold_mutation": false
  },
  "shared_deep_replay": {
    "enabled": true,
    "active_count": 5,
    "symbols": ["BTC-USDT", "ETH-USDT"],
    "canonical_evaluator": "backend/research/rebuild/a1_exact25_generic_evaluator_v1.py",
    "canonical_ledger_is_never_mutated": true,
    "temporary_terminal_replay_ledger_only": true,
    "bar_fetch_cache_key": ["symbol", "interval", "limit"],
    "execution_snapshot_cache_key": ["symbol"],
    "one_process_shared_cache": true
  },
  "classification": {
    "positive_non_top10": "SYNTHESIS_MATERIAL_CANDIDATE",
    "sparse_or_data_blocked": "DORMANT",
    "economic_cost_or_causal_fail": "REJECT",
    "otherwise": "HOLD"
  },
  "strict_reference": {
    "profit_minimum_completed_trades": 10,
    "certification_and_a3_pilot_minimum_completed_trades": 12,
    "strict_25_trade_certification_remains_parallel": true,
    "global_strict_policy_unchanged": true
  }
}
