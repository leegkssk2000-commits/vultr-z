{
  "schema_version": "zel.a1.strategy25_triage_external_evidence.v1",
  "state": "BOUND_RESEARCH_ONLY",
  "purpose": "Protect strategies with demonstrated economic improvement, diagnose and repair viable parents with failing children, fully rebuild structurally weak strategies, and systematically mine high-view YouTube/Gemini, papers, exchange documentation, and other public research for reproducible mechanism hypotheses without granting external evidence promotion authority.",
  "binds_to": [
    "backend/research/contracts/a1_g14_profit_track_p0_p7_v1.json",
    "A1:P1_ECONOMIC_TRUTH_TABLE_25_WIDE",
    "A1:P2_DEV_SEARCH_V2",
    "A1:P3_FAST_KILL_FAILOVER",
    "A1:P4_MATURITY_FRESH_CAUSAL"
  ],
  "strategy_triage": {
    "KEEP_ACCUMULATE": {
      "objective": "Do not disturb an improving incumbent. Preserve the current best economic child and continue prospective/fresh/OOS accumulation.",
      "strategies": ["trend_rider", "keltner_trend", "break_and_continue"],
      "rules": [
        "incumbent_mutation_forbidden_without_existing_non_regression_trigger",
        "parallel_hypothesis_research_allowed_but_cannot_replace_incumbent",
        "fresh_oos_collection_has_priority_over_new_retuning",
        "failed_new_child_never_resets_accumulated_progress",
        "promotion_requires_existing_A1_A2_A3_gates"
      ]
    },
    "DIAGNOSE_REPAIR": {
      "objective": "Preserve economically viable parent behavior while replacing or repairing only the failing child/mechanism.",
      "strategies": ["supertrend_pullback", "trend_ma_macd"],
      "required_diagnosis_axes": ["regime", "side", "symbol", "session", "entry_context", "exit_reason", "cost_drag", "winner_retention", "loss_cluster", "drawdown_concentration", "common_mode_exposure"],
      "rules": [
        "parent_preserved",
        "failed_child_is_not_incumbent",
        "one_primary_causal_axis_per_repair_child",
        "exact_parent_same_cost_comparison_required",
        "fresh_oos_required_after_development_pass"
      ]
    },
    "FULL_REBUILD": {
      "objective": "Treat the existing strategy as a frozen diagnostic baseline only. Rebuild entry/context/exit architecture from explicit mechanism hypotheses rather than parameter tuning.",
      "strategies": ["liquidity_sweep", "grid_rebalance", "scalp_snap", "rsi_swing_fail", "range_fade", "vol_spike_fade", "vwap_revert", "obv_trend", "pivot_reversal"],
      "rebuild_order": ["failure_attribution", "mechanism_hypothesis_generation", "external_evidence_crosscheck", "architecture_v2_child", "retrospective_sanity_only", "future_boundary_freeze", "fresh_oos", "H4_H5", "A2_A3"],
      "rules": [
        "original_strategy_remains_frozen_reference",
        "numeric_threshold_sweep_forbidden_as_primary_rebuild_method",
        "architecture_change_must_have_named_mechanism",
        "external_source_claim_never_counts_as_local_economic_pass",
        "new_child_identity_required"
      ]
    },
    "MECHANISM_REBUILD": {
      "objective": "Insufficient or weak events plus negative economics: rediscover the signal mechanism before optimizing parameters.",
      "strategies": ["bb_revert", "turtle_trend", "ema_ribbon_scalp", "rbreaker_like", "squeeze_break"],
      "rules": ["signal_mechanism_first", "event_density_and_cost_feasibility_checked_before_tuning", "minimum viable event generation must be demonstrated before economic optimization", "fresh boundary required for any promotion path"]
    },
    "ZERO_EVENT_REBUILD": {
      "objective": "There is no meaningful trade sample to optimize. Rebuild signal generation and admission from first principles.",
      "strategies": ["alpha_combo", "anchor_vwap_trend", "fvg_revert", "mfi_rsi_div", "session_bias", "sr_levels"],
      "rebuild_order": ["source_and_feature_availability", "signal_generation_truth_table", "admission_bottleneck", "event_density", "cost_feasibility", "architecture_v2", "prospective_collection"],
      "rules": ["zero_event_strategy_cannot_be_called_improved", "parameter_optimization_before_event_generation_is_forbidden", "new_strategy_identity_or_explicit_v2_identity_required"]
    }
  },
  "external_evidence_engine": {
    "role": "HYPOTHESIS_DISCOVERY_AND_MECHANISM_CROSSCHECK_ONLY",
    "promotion_authority": false,
    "selection_authority": false,
    "local_replay_required": true,
    "source_priority": {
      "DISCOVERY_PRIORITY": ["HIGH_VIEW_YOUTUBE_DIRECT_GEMINI", "PEER_REVIEWED_PAPERS", "ARXIV_SSRN_PREPRINTS", "EXCHANGE_AND_MARKET_MICROSTRUCTURE_DOCUMENTATION", "REPUTABLE_QUANT_RESEARCH_AND_TECHNICAL_BLOGS", "OPEN_SOURCE_IMPLEMENTATIONS"],
      "EVIDENCE_AUTHORITY": ["LOCAL_REPRODUCIBLE_REPLAY_AND_PROSPECTIVE_DATA", "PEER_REVIEWED_OR_HIGH_QUALITY_EMPIRICAL_RESEARCH", "EXCHANGE_PRIMARY_DOCUMENTATION", "PREPRINT_OR_INDEPENDENT_RESEARCH", "YOUTUBE_OR_CREATOR_CONTENT"],
      "note": "Popularity determines discovery priority, not truth authority. High-view videos are mined aggressively for mechanisms, then independently checked and locally tested."
    },
    "youtube_gemini": {
      "enabled": true,
      "existing_receipt": "backend/research/architecture_factory/a1_youtube_diversity_latest.json",
      "direct_video_analysis_required": true,
      "high_view_discovery_required": true,
      "view_metadata": {
        "observed_views_required_for_high_view_label": true,
        "published_at_preferred": true,
        "channel_required": true,
        "view_count_verified_required_for_ranked_high_view_claim": true,
        "unverified_view_count_action": "KEEP_AS_UNRANKED_HYPOTHESIS_ONLY",
        "fixed_absolute_view_threshold": null,
        "ranking_rule": "WITHIN_EACH_MECHANISM_QUERY_BUCKET_RANK_BY_VERIFIED_VIEW_COUNT_THEN_DIVERSIFY_BY_CHANNEL_AND_MECHANISM"
      },
      "per_bucket_workflow": {
        "candidate_pool_target": "TOP_10_AVAILABLE_BY_VERIFIED_VIEWS_WHEN_METADATA_AVAILABLE",
        "deep_analysis_target": "TOP_3_TO_5_NON_DUPLICATE_VIDEOS",
        "deduplication": "SAME_MECHANISM_OR_TRANSCRIPT_SEMANTIC_DUPLICATES_COLLAPSED",
        "gemini_extract": ["creator_claims", "reproducible_mechanisms", "entry_time_features", "regime_conditions", "entry_logic", "exit_logic", "risk_logic", "failure_modes", "required_data", "marketing_or_unverified_claims", "local_test_needed"]
      },
      "anti_hype": ["affiliate_or_profit_claims_never_count_as_evidence", "visual_chart_examples_are_not_statistical_validation", "creator_thresholds_are_not_imported_directly", "proprietary_indicator_claims_require_reproducible_proxy_or_are_rejected"]
    },
    "papers_and_public_research": {
      "enabled": true,
      "search_domains": ["market_microstructure", "momentum_and_trend", "mean_reversion", "volatility_regimes", "liquidity_and_order_flow", "funding_basis_open_interest", "breakout_persistence", "session_and_intraday_seasonality", "transaction_costs_and_slippage", "risk_budgeting_and_drawdown_control", "crypto_specific_market_structure"],
      "preferred_sources": ["peer_reviewed_journals", "arxiv", "ssrn", "university_or_research_institute_publications", "exchange_primary_docs", "reputable_quant_research"],
      "required_extract": ["mechanism", "dataset", "sample_period", "market", "feature_definition", "reported_effect", "cost_assumptions", "failure_conditions", "replication_requirements", "applicability_to_BingX_USDT_M_or_proxy_limits"],
      "crosscheck_rule": "A_VIDEO_DERIVED_MECHANISM_SHOULD_SEEK_AT_LEAST_ONE_INDEPENDENT_NON_CREATOR_SOURCE_WHEN_PRACTICABLE_BEFORE_EXPENSIVE_REBUILD_WORK",
      "absence_of_paper_support": "DOES_NOT_AUTOMATICALLY_REJECT_A_MECHANISM_IF_LOCALLY_TESTABLE"
    },
    "hypothesis_score": {
      "dimensions": ["mechanism_clarity", "data_availability", "independent_support", "implementation_cost", "expected_event_density", "cost_robustness", "distinctness_from_failed_axes"],
      "rule": "PRIORITIZE_CLEAR_TESTABLE_DISTINCT_MECHANISMS; DO_NOT_SCORE_CREATOR_POPULARITY_AS_ECONOMIC_EVIDENCE"
    }
  },
  "research_budget_routing": {
    "KEEP_ACCUMULATE": "LOW_MUTATION_HIGH_VALIDATION_BUDGET",
    "DIAGNOSE_REPAIR": "MEDIUM_DIAGNOSTIC_BUDGET_ONE_AXIS_REPAIR",
    "FULL_REBUILD": "HIGH_MECHANISM_DISCOVERY_AND_ARCHITECTURE_BUDGET",
    "MECHANISM_REBUILD": "MEDIUM_HIGH_DISCOVERY_BUDGET",
    "ZERO_EVENT_REBUILD": "SIGNAL_GENERATION_AND_DATA_BUDGET_FIRST",
