{
  "schema_version": "zel.g10_execution_quality_contract.v1",
  "stage": "G10_PREP",
  "purpose": "read-only execution-quality collection and calibration preparation",
  "reuse": {
    "a2_cost_ssot": "backend/research/prep/a2_cost_turnover_ssot_v1.json",
    "duplicate_collector_forbidden": true,
    "network_calls_owned_by_runtime": false
  },
  "source_contract": {
    "exchange": "BingX",
    "public_depth": "/openApi/swap/v2/quote/depth",
    "public_funding": "/openApi/swap/v2/quote/fundingRate",
    "public_klines": "/openApi/swap/v3/quote/klines",
    "private_order_data_required_for": ["realized_maker_taker", "partial_fill", "reject", "latency", "stop_execution"],
    "private_data_mode": "READ_ONLY_WHEN_EXISTING_HISTORY_IS_AVAILABLE"
  },
  "record_schema": {
    "required": ["record_id", "ts_utc", "symbol", "source_sha", "source_type"],
    "optional_metrics": ["maker_fee_bps", "taker_fee_bps", "spread_bps", "depth_vwap_impact_bps", "notional_usdt", "funding_bps", "partial_fill_ratio", "latency_ms", "rejected", "stop_slippage_bps", "fill_quality_bps"],
    "size_bucket_usdt_edges": [1000, 5000, 10000, 25000, 50000]
  },
  "append_only": {"record_id_unique": true, "parent_digest_required_after_first": true, "rewrite_forbidden": true},
  "calibration_outputs": ["maker_taker_fee_lineage", "spread_distribution", "size_bucket_slippage", "funding_distribution", "partial_fill_rate", "latency_distribution", "reject_rate", "stop_execution_slippage"],
  "prohibitions": ["order_submit", "shadow_start", "paper_start", "live_start", "survivor_revoke_or_promote"],
  "authority": {"selection_authority": false, "promotion_authority": false, "execution_authority": "NONE", "order_authority": "BLOCKED", "live_trade_authority": "BLOCKED", "exchange_order_submitted": false, "protected_mutations": 0}
}
