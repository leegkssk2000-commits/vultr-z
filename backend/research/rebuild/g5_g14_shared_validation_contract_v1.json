{
  "schema_version": "zel.g5_g14.shared_validation_contract.v2",
  "status": "LOCK_PENDING_ACTIONS_REPLAY",
  "scope": {
    "from_generation": 5,
    "to_generation": 14,
    "reuse_required": true,
    "rebuild_per_generation_forbidden": true
  },
  "stage_authority": {
    "G5": "INDEPENDENT_OOS_WALK_FORWARD_STRESS_VALIDATION",
    "G6": "TRADE_METHOD_STANDALONE",
    "source": "GitHub issue #566 ZEL Unattended Gate FSM"
  },
  "shared_invariants": {
    "clean_runner_exactly_once": true,
    "source_parity_required": true,
    "child_identity_required": true,
    "duplicate_allowed": 0,
    "lookahead_allowed": 0,
    "economic_ledger_required": true,
    "telemetry_required": true,
    "data_stale_authority_required_before_fresh_credit": true,
    "fresh_credit_fail_closed": true,
    "paid_ai_required": false
  },
  "controller_stages": [
    "CONTRACT_VALID",
    "AUTHORITY_INPUTS_PRESENT",
    "AUTHORITY_SHA_LOCK_VALID",
    "CLEAN_RUNNER_SHADOW_PASS",
    "TELEMETRY_COMPLETE",
    "DATA_STALE_AUTHORITY_VALID",
    "CUTOVER_AND_POST_CUTOVER_READY",
    "GENUINE_ECONOMIC_T_PRESENT",
    "G5_TERMINAL_PASS"
  ],
  "cutover": {
    "automatic": false,
    "approval_required": true,
    "post_cutover_genuine_bars_required": 3
  },
  "genuine_economic_t": {
    "min_production_grade_rows": 1,
    "proxy_rows_do_not_count": true
  },
  "g5_terminal_gate": {
    "required_schema_version": "zel.g5.independent_validation.terminal.v1",
    "required_state": "G5_TERMINAL_PASS",
    "required_true": [
      "oos_pass",
      "walk_forward_pass",
      "stress_pass",
      "source_owner_parity",
      "baseline_economic_digest_parity",
      "w1_selection_frozen_through_w3",
      "fee_slippage_funding_lineage_complete"
    ],
    "required_false": [
      "future_mfe_mae_leakage",
      "protected_mutation"
    ],
    "integrity_equals": {
      "errors": 0,
      "duplicate": 0,
      "censored_open": 0,
      "unknown_exit": 0
    },
    "economic_window_thresholds": {
      "net_r_gt": 0,
      "pf_gte": 1,
      "expectancy_gt": 0,
      "payoff_gte": 1,
      "retention_pct_gte": 60
    }
  },
  "generation_unlock_rule": "G(n+1)_ALLOWED_IFF_G(n)_TERMINAL_PASS",
  "hard_fail_on": [
    "gate_skip",
    "authority_input_missing_or_schema_mismatch",
    "authority_sha_drift",
    "terminal_receipt_sha_drift",
    "duplicate_transition",
    "shared_invariant_drift",
    "data_stale_threshold_without_authority",
    "fresh_credit_without_production_ready"
  ]
}
