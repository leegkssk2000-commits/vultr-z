{
  "schema_version": "zel.g5.pipeline_bottleneck_closure_contract.v1",
  "scope": "G5_ONLY",
  "objective": "separate pipeline defects from genuine strategy economics and prevent serial hidden bottlenecks",
  "watchdog": {
    "cadence_minutes": 10,
    "required_stages": [
      "source_bar",
      "raw_signal",
      "actionable_signal",
      "entry_or_maturing",
      "closed_candidate",
      "settled_closed",
      "forward_real_provenance",
      "production_grade_ledger"
    ],
    "closed_T_zero_must_classify": true,
    "allowed_zero_T_classes": [
      "SIGNAL_STARVATION",
      "ADMISSION_REJECTING_ALL_RAW_SIGNALS",
      "ACTIONABLE_SIGNAL_NOT_OPENED",
      "SIGNAL_LIVE_MATURING",
      "CLOSED_CANDIDATE_WAITING_SETTLEMENT_OR_WRITER",
      "UPSTREAM_SIGNAL_STARVATION",
      "PROVENANCE_OR_WRITER_PATH_REVIEW_REQUIRED"
    ]
  },
  "trendrider_bbo": {
    "future_only": true,
    "historical_backfill": false,
    "capture_cadence_minutes": 10,
    "capture_gap_must_be_observable": true,
    "formal_credit": 0
  },
  "broad_parent": {
    "role": "FAILED_CONTROL_ONLY",
    "retune": false,
    "wait_for_more_parent_T": false
  },
  "guards": {
    "strategy_retune": false,
    "rr_exit_mutation": false,
    "g6_advance": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "live_trade_authority": "BLOCKED"
  }
}
