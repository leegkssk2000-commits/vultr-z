{
  "schema_version": "strategy11.ai_quota_error_budget.v1",
  "policy": "INTERNAL_CONSERVATIVE_BUDGET_NOT_PROVIDER_LIMIT",
  "providers": {
    "gemini": {
      "role": "MULTIMODAL_HYPOTHESIS_ONLY",
      "max_calls_per_strategy_epoch": 2,
      "max_consecutive_failures": 2,
      "fallback": "HOLD_MULTIMODAL_OR_INTERNAL_EVIDENCE_ONLY"
    },
    "groq": {
      "role": "SEMANTIC_RED_TEAM",
      "max_calls_per_hour": 20,
      "max_calls_per_day": 100,
      "max_candidates_per_call": 10,
      "max_consecutive_failures": 2,
      "fallback": "HOLD_EXTERNAL_HYPOTHESIS"
    },
    "workers_ai": {
      "role": "SCHEMA_LINEAGE_SAFETY_GUARD",
      "max_calls_per_hour": 40,
      "max_calls_per_day": 200,
      "max_consecutive_failures": 2,
      "fallback": "LOCAL_DETERMINISTIC_GUARD_AND_HOLD_EXTERNAL_CHAIN"
    },
    "github_models": {
      "role": "MAJOR_GATE_REVIEW_ONLY",
      "max_calls_per_gate": 3,
      "max_calls_per_day": 20,
      "max_consecutive_failures": 2,
      "fallback": "HOLD_MAJOR_GATE_UNTIL_NEXT_QUOTA_WINDOW"
    }
  },
  "telemetry_required": [
    "provider",
    "stage",
    "run_id",
    "actual_model",
    "latency_ms",
    "input_sha",
    "prompt_sha",
    "response_sha",
    "usage",
    "decision",
    "blocker_codes"
  ],
  "paid_fallback_allowed": false,
  "promotion_authority": false,
  "protected_mutations": 0,
  "execution_allowed": false,
  "order_authority": "BLOCKED"
}
