{
  "schema_version": "3.0",
  "authority": "GEMINI_ACTIVE_RESEARCH_POLICY_NO_STRATEGY_AUTHORITY",
  "mode": "ACTIVE_FREE_ONLY",
  "free_only": true,
  "paid_grounding_forbidden": true,
  "vertex_forbidden": true,
  "automatic_billing_forbidden": true,
  "usage_policy": {
    "default_posture": "USE_WHEN_RESEARCH_CAN_CHANGE_THE_NEXT_TEST",
    "mandatory_gates": [
      "BEFORE_FIRST_REPAIR_FOR_DATA_ADEQUATE_CANDIDATE",
      "AFTER_REPAIR_FAILURE_WITH_UNRESOLVED_CAUSE",
      "BEFORE_FINAL_RESEARCH_EXHAUSTED_HOLD",
      "WHEN_CHART_OR_CANDLE_EVIDENCE_CONFLICTS_WITH_SUMMARY_METRICS",
      "WHEN_NEW_NON_OVERLAP_WINDOW_CHANGES_FAILURE_CLUSTER"
    ],
    "do_not_wait_for_internal_three_iteration_exhaustion": true,
    "reuse_prior_source_audit_when_unchanged": true,
    "new_call_required_when_failure_fingerprint_changes": true,
    "provider_quota_behavior": "CONSUME_AVAILABLE_FREE_QUOTA_FOR_RELEVANT_RESEARCH_THEN_HOLD_ON_PROVIDER_LIMIT"
  },
  "source_policy": {
    "minimum_public_videos": 4,
    "minimum_independent_channels": 4,
    "prefer_high_view": true,
    "single_video_authority_forbidden": true,
    "papers_per_query": 4,
    "max_literature_sources": 24,
    "literature_queries": [
      "ATR volatility stop loss trading backtest transaction costs",
      "ATR trailing stop trend following exit drawdown",
      "MFE MAE exit optimization trading strategy",
      "probability of backtest overfitting multiple testing trading",
      "walk forward analysis transaction costs algorithmic trading"
    ],
    "reject_marketing_without_reproducible_method": true,
    "cross_source_contradiction_required": true
  },
  "internal_evidence_policy": {
    "anonymize_strategy_ids_for_model": true,
    "private_code_forbidden": true,
    "api_keys_forbidden": true,
    "exchange_credentials_forbidden": true,
    "account_and_order_data_forbidden": true,
    "include_variant_metrics": true,
    "include_mfe_mae": true,
    "include_failure_clusters": true,
    "include_exit_reason_breakdown": true,
    "include_symbol_regime_window_breakdown": true,
    "include_anonymized_chart_images": true,
    "include_representative_candle_images_when_available": true
  },
  "analysis_policy": {
    "source_audit_call": true,
    "strategy_multimodal_calls": 3,
    "independent_red_team_call": true,
    "separate_observation_from_causality": true,
    "no_multi_axis_hypothesis": true,
    "no_unbounded_parameter_search": true,
    "no_external_performance_claim": true,
    "all_outputs_hypothesis_external": true
  },
  "execution_policy": {
    "max_hypotheses_per_strategy": 2,
    "max_active_hypotheses_global": 3,
    "isolated_child_only": true,
    "full_state_replay_required": true,
    "selection_validation_holdout_fresh_required": true,
    "cost_funding_slippage_latency_stress_required": true,
    "new_sealed_non_overlap_required_for_core": true,
    "canonical_mutation_forbidden": true,
    "registry_mutation_forbidden": true,
    "runtime_shadow_paper_live_order_mutation_forbidden": true
  }
}
