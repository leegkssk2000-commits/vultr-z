{
  "schema_version": "1.0",
  "authority": "READ_ONLY_RESEARCH_NO_EXECUTION",
  "improve_priority": "REPRODUCIBILITY_FIRST",
  "priority_order": [
    "FRESH_REPRODUCIBILITY",
    "MAX_DRAWDOWN",
    "PROFIT_FACTOR_PAYOFF",
    "NET_RETURN",
    "WIN_RATE"
  ],
  "promotion": {
    "min_delta_net_pct_points": 0.5,
    "min_delta_profit_factor": 0.1,
    "min_delta_payoff_ratio": 0.1,
    "min_improved_primary_metrics": 2,
    "max_drawdown_degradation_pct_points": 0.0,
    "min_trade_retention_pct": 80.0,
    "min_positive_fresh_windows_pct": 70.0
  },
  "repair_budget": {
    "max_iterations_per_strategy": 3,
    "max_active_candidates": 3,
    "max_alternatives_per_iteration": 2,
    "no_change_control_required": true,
    "single_cause_change_required": true
  },
  "shadow_admission": {
    "core_limit": 2,
    "synthesis_limit": 1,
    "total_limit": 3,
    "fill_quota": false
  },
  "data_adequacy": {
    "min_fresh_trades_per_promoted_candidate": 12,
    "min_distinct_fresh_windows": 3,
    "sealed_final_holdback_required": true,
    "sealed_final_holdback_one_shot": true,
    "reuse_sealed_holdback_during_repair": false,
    "mfe_mae_evidence_required": true,
    "cost_stress_grid_required": true,
    "funding_stress_required": true,
    "latency_stress_required": true
  },
  "ranking_safety": {
    "min_trades_for_profit_factor_ranking": 20,
    "profit_factor_cap_for_score": 10.0,
    "payoff_ratio_cap_for_score": 10.0,
    "bayesian_shrinkage_trade_prior": 30,
    "low_sample_metric_explosion_is_blocker": true
  },
  "statistical_validation": {
    "bootstrap_confidence_level": 0.95,
    "bootstrap_samples": 2000,
    "block_bootstrap_required": true,
    "multiple_hypothesis_correction": "BH_FDR",
    "fdr_q": 0.1,
    "probability_of_backtest_overfitting_max": 0.2,
    "deflated_sharpe_required": true
  },
  "cost_stress": {
    "fee_multipliers": [1.0, 1.5, 2.0],
    "slippage_multipliers": [1.0, 1.5, 2.0],
    "funding_scenarios": ["OBSERVED", "ADVERSE_P75", "ADVERSE_P95"],
    "latency_scenarios": ["NEXT_BAR_OPEN", "PLUS_ONE_BAR"]
  },
  "gemini": {
    "enabled_after_data_gate": true,
    "free_only": true,
    "minimum_videos_per_topic": 3,
    "minimum_independent_channels": 2,
    "high_view_priority": true,
    "single_video_decision_forbidden": true,
    "external_claim_label": "HYPOTHESIS_EXTERNAL"
  },
  "safety": {
    "canonical_mutation_allowed": false,
    "registry_mutation_allowed": false,
    "route_allowed": false,
    "shadow_allowed_before_promotion": false,
    "paper_allowed": false,
    "live_allowed": false,
    "execution_allowed": false
  }
}
