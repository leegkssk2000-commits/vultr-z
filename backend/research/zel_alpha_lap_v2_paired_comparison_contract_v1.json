  "evidence_sequence": [
    "DATA_B",
    "W2",
    "W3",
    "SHADOW_20C",
    "SHADOW_100C",
    "SHADOW_200C",
    "SHADOW_300C",
    "PAPER_CANARY"
  ],
  "threshold_source": [
    "Z_POLICY_V3",
    "SSOT_ENUM_THRESHOLD_UNIT_SOURCE"
  ],
  "safety": {
    "selection_authority": false,
    "promotion_authority": false,
    "runtime_binding_allowed": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "action": "hold"
  }
}
