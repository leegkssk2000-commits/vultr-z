{
  "schema_version": "zel.alpha_lap.v2.paired_comparison.contract.v1",
  "comparison_unit": "champion_vs_challenger_same_opportunity",
  "required_pair_keys": [
    "timestamp",
    "symbol",
    "side",
    "regime",
    "signal_opportunity_id",
    "position_budget_id",
    "risk_model_sha256",
    "cost_model_sha256",
    "data_manifest_sha256"
  ],
  "required_metrics": [
    "net_r_delta",
    "expectancy_r_delta",
    "profit_factor_delta",
    "win_rate_delta",
    "payoff_ratio_delta",
    "max_drawdown_r_delta",
    "max_consecutive_losses_delta",
    "tail_loss_delta",
    "fee_r_delta",
    "slippage_r_delta",
    "funding_r_delta",
    "latency_ms_delta",
    "fill_probability_delta",
    "rejection_rate_delta",
    "duplicate_count_delta",
    "orphan_count_delta",
    "lineage_completeness_pct_delta",
    "joint_drawdown_r_delta",
    "margin_conflict_count_delta",
    "portfolio_marginal_contribution_delta"
  ],
  "comparison_rules": {
    "same_market_time_required": true,
    "same_cost_model_required": true,
    "same_risk_budget_required": true,
    "same_signal_opportunity_required": true,
    "unpaired_period_comparison_for_promotion_forbidden": true,
