{
  "schema_version": "zel.bingx_execution_evidence_collector.contract.v1",
  "state": "DESIGN_LOCKED_READ_ONLY",
  "official_read_endpoints": [
    "/openApi/swap/v3/user/balance",
    "/openApi/swap/v2/user/positions",
    "/openApi/swap/v2/user/commissionRate",
    "/openApi/swap/v2/user/income"
  ],
  "methods_allowed": ["GET"],
  "methods_forbidden": ["POST", "PUT", "PATCH", "DELETE"],
  "base_urls": ["https://open-api.bingx.com", "https://open-api.bingx.pro"],
  "credential_policy": {
    "environment_variables": ["BINGX_API_KEY", "BINGX_SECRET_KEY"],
    "repository_storage": false,
    "chat_storage": false,
    "receipt_storage": false,
    "raw_log_storage": false,
    "read_only_exchange_permission_required": true
  },
  "collection": {
    "income_lookback_days_max": 90,
    "initial_window_hours": 168,
    "minimum_split_window_minutes": 60,
    "limit": 1000,
    "adaptive_window_split_when_full": true,
    "deduplication": "SHA256_CANONICAL_REDACTED_EVENT",
    "utc_only": true,
    "optional_local_fill_import": true,
    "local_fill_import_purpose": ["slippage", "first_fill_latency", "final_fill_latency", "partial_fill", "reject"]
  },
  "output": {
    "raw_response_persistence": false,
    "redacted_evidence_json": true,
    "sha_manifest": true,
    "coverage_receipt": true,
    "missing_interval_detection": true
  },
  "safety": {
    "read_only": true,
    "runtime_application": false,
    "strategy_mutation": false,
    "registry_write": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "action": "hold"
  }
}
