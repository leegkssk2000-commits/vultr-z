{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-os.vip/schema/zel_economic_hardening_input_schema_v1.json",
  "title": "ZEL Economic Hardening H1-H5 Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "strategy_family",
    "archetype_candidate",
    "bingx_light_calibration",
    "placebo_negative_controls",
    "concentration_fragility"
  ],
  "properties": {
    "schema_version": {"const": "zel.economic_hardening.fixture.v1"},
    "version": {"type": "string", "minLength": 1},
    "strategy_family": {
      "type": "object",
      "required": ["strategy_id", "family_id", "data_sha256", "window_sha256", "approved_axes", "family_summary", "axis_attempts"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "window_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_axes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "family_summary": {
          "type": "object",
          "required": ["gross_expectancy_R", "cost_adjusted_expectancy_R", "retention_pct", "adjacent_parameter_positive_ratio"]
        },
        "axis_attempts": {"type": "array", "minItems": 1}
      }
    },
    "archetype_candidate": {
      "type": "object",
      "required": [
        "archetype_id",
        "economic_mechanism",
        "entry_time_features",
        "external_evidence_ids",
        "falsification_rule",
        "source_sha256",
        "data_sha256",
        "code_sha256",
        "parameter_variant_of_rejected_family",
        "structural_signature",
        "existing_structural_signatures"
      ]
    },
    "bingx_light_calibration": {
      "type": "object",
      "required": [
        "observed_at",
        "source_tier",
        "source_identifier",
        "source_url",
        "account_fee_tier",
        "account_specific_verified",
        "maker_fee_pct",
        "taker_fee_pct",
        "funding_p95_abs_pct_8h",
        "slippage_floor_bps_by_notional",
        "latency_ms_p50",
        "latency_ms_p95",
        "plus_one_bar_stress_required"
      ]
    },
    "placebo_negative_controls": {
      "type": "object",
      "required": ["candidate", "controls"],
      "properties": {
        "candidate": {
          "type": "object",
          "required": ["trade_count", "window_sha256", "cost_model_sha256", "net_R", "expectancy_R"]
        },
        "controls": {
          "type": "object",
          "required": ["same_count_random_entry", "one_bar_delay", "direction_inversion", "timestamp_shuffle", "indicator_removal"]
        }
      }
    },
    "concentration_fragility": {
      "type": "object",
      "required": ["thresholds_sealed_at", "holdout_opened_at", "top10_trade_profit_share", "dimensions", "leave_one_group_out"],
      "properties": {
        "dimensions": {
          "type": "object",
          "required": ["symbol", "regime", "side", "session", "window"]
        },
        "leave_one_group_out": {"type": "array", "minItems": 1}
      }
    }
  }
}
