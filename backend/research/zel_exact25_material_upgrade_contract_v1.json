{
  "schema_version": "zel.exact25.material_upgrade_contract.v1",
  "target_strategy_count": 25,
  "objective": "Upgrade every strategy into independently useful synthesis material before ensemble use.",
  "automatic": true,
  "user_configuration_required": false,
  "trigger_conditions": [
    "DATA_B_15M_AND_1M_TERMINAL",
    "NEW_W1_OR_FORWARD_EVIDENCE",
    "MATERIAL_UPGRADE_WORKFLOW_SCHEDULE"
  ],
  "required_order": [
    "DIAGNOSE_ALL25",
    "SOURCE_SURFACE_DISCOVERY",
    "ONE_AXIS_CHILD_VARIANT",
    "DATA_B_15M_AND_1M_REPLAY",
    "W2_NEW_FORWARD_IF_PASS",
    "W3_TEMPORAL_DURABILITY_IF_PASS",
    "SEALED_FINAL_HOLDOUT_IF_PASS",
    "REAL_SHADOW_IF_PASS",
    "MATERIAL_POOL_IF_PASS"
  ],
  "failure_classes": {
    "STRATEGY_EXECUTION_ERROR": {
      "axis": "SOURCE_OR_RUNTIME_CONTRACT",
      "repair": "SOURCE_AUDIT"
    },
    "NO_SIGNAL_DORMANT": {
      "axis": "ENTRY_TRIGGER_THRESHOLD",
      "repair": "COUNTERFACTUAL_TRIGGER_PROBE"
    },
    "SIGNAL_WITH_INVALID_ENTRY": {
      "axis": "ENTRY_SCHEMA_OR_RISK_FIELDS",
      "repair": "OUTPUT_CONTRACT_REPAIR"
    },
    "VALID_ENTRY_NOT_OPENED": {
      "axis": "POSITION_CONSTRUCTION_CONTRACT",
      "repair": "OPEN_PATH_REPAIR"
    },
    "OPEN_WITHOUT_CLOSE": {
      "axis": "EXIT_COVERAGE",
      "repair": "EXIT_PATH_REPAIR"
    },
    "LOW_SAMPLE_RARE_OR_OVERFILTERED": {
      "axis": "ENTRY_FILTER_SELECTIVITY",
      "repair": "SINGLE_FILTER_RELAXATION"
    },
    "THIN_SAMPLE": {
      "axis": "ENTRY_FILTER_SELECTIVITY",
      "repair": "SINGLE_FILTER_RELAXATION"
    },
    "NEGATIVE_EDGE_WITH_CAPTURE_LEAK": {
      "axis": "EXIT_CAPTURE",
      "repair": "SINGLE_EXIT_VARIANT"
    },
    "NEGATIVE_EDGE_WITH_LONG_EXPOSURE": {
      "axis": "TIME_EXPOSURE",
      "repair": "SINGLE_TIME_STOP_VARIANT"
    },
    "NEGATIVE_OR_UNSTABLE_EDGE": {
      "axis": "REGIME_FILTER",
      "repair": "SINGLE_REGIME_VARIANT"
    }
  },
  "material_gate": {
    "minimum_closed_trades": 300,
    "expectancy_r": ">0",
    "profit_factor": ">=1.0",
    "execution_errors": 0,
    "data_b_intervals": [
      "15m",
      "1m"
    ],
    "w2_required": true,
    "w3_required": true,
    "zero_or_low_sample_direct_synthesis_forbidden": true,
    "negative_edge_direct_synthesis_forbidden": true
  },
  "optimization_policy": {
    "max_changed_axes_per_child": 1,
    "max_children_per_strategy_per_epoch": 3,
    "same_evidence_reoptimization_forbidden_after_rejection": true,
    "new_epoch_requires_new_data_or_new_causal_evidence": true,
    "metric_cherry_picking_forbidden": true,
    "canonical_strategy_mutation_before_full_pass": false,
    "canonical_registry_mutation_before_full_pass": false
  },
  "synthesis_policy": {
    "raw_strategy_is_not_automatically_material": true,
    "material_must_pass_independent_quality_gate": true,
    "complementarity_does_not_override_negative_expectancy": true,
    "rare_specialist_allowed_only_after_opportunity_normalized_validation": true,
    "failed_material_remains_available_for_failure_learning_only": true
  },
  "safety": {
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "paper_enabled": false,
    "live_enabled": false,
    "action": "hold"
  }
}
