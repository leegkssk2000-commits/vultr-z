{
  "schema_version": "zel.intratrade_path_evidence.contract.v1",
  "version": "ZEL_INTRATRADE_PATH_EVIDENCE_CONTRACT_V1",
  "state": "FROZEN_RESEARCH_ONLY",
  "bundles": [
    {
      "bundle_id": "BAR_PATH_BUNDLE",
      "required_fields": [
        "event_id",
        "symbol",
        "side",
        "entry_ts",
        "exit_ts",
        "bar_timestamp_path",
        "bar_open_path",
        "bar_high_path",
        "bar_low_path",
        "bar_close_path",
        "position_size_path"
      ],
      "invariants": [
        "all_path_arrays_equal_length",
        "path_length_gte_2",
        "timestamps_strictly_increasing",
        "first_timestamp_lte_entry_ts",
        "last_timestamp_gte_exit_ts",
        "ohlc_finite",
        "high_gte_max_open_close_low",
        "low_lte_min_open_close_high",
        "position_size_non_negative"
      ],
      "supports": [
        "SK_POS_TRAILING_STOP",
        "SK_POS_PARTIAL_EXIT",
        "SK_POS_MFE_RUNNER",
        "SK_POS_SCALE_IN",
        "NUMERIC_TARGET_R_REPLAY"
      ]
    },
    {
      "bundle_id": "TICK_PATH_BUNDLE",
      "required_fields": [
        "event_id",
        "symbol",
        "side",
        "entry_ts",
        "exit_ts",
        "timestamp_path",
        "intratrade_price_path",
        "position_size_path"
      ],
      "invariants": [
        "all_path_arrays_equal_length",
        "path_length_gte_2",
        "timestamps_strictly_increasing",
        "first_timestamp_lte_entry_ts",
        "last_timestamp_gte_exit_ts",
        "prices_finite_and_positive",
        "position_size_non_negative"
      ],
      "supports": [
        "SK_POS_TRAILING_STOP",
        "SK_POS_PARTIAL_EXIT",
        "SK_POS_MFE_RUNNER",
        "SK_POS_SCALE_IN",
        "NUMERIC_TARGET_R_REPLAY"
      ]
    }
  ],
  "lineage": {
    "required_fields": [
      "path_source",
      "path_source_sha256",
      "strategy_config_sha256",
      "signal_source_sha256",
      "interval",
      "timezone"
    ],
    "accepted_path_source_prefixes": [
      "cf:/",
      "sheets:/",
      "sealed_dataset:/"
    ],
    "raw_exchange_private_ids_forbidden": true
  },
  "rules": {
    "closed_trade_summary_only_is_insufficient": true,
    "mfe_mae_only_is_insufficient": true,
    "synthetic_interpolation_forbidden": true,
    "forward_fill_across_missing_bars_forbidden": true,
    "economic_claim_requires_complete_bundle_and_lineage": true,
    "missing_or_invalid_evidence_action": "hold"
  },
  "safety": {
    "action": "hold",
    "active_data_b_1m_mutated": false,
    "canonical_strategy_files_mutated": false,
    "formal_ledger_mutated": false,
    "runtime_registry_mutated": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED"
  }
}
