{
  "schema_version": "zel.lico.provenance_acquisition.contract.v1",
  "version": "ZEL_LICO_PROVENANCE_ACQUISITION_CONTRACT_V1",
  "state": "FROZEN_RESEARCH_ONLY",
  "source_priority": ["cf:/", "sheets:/"],
  "required_trade_join_keys": ["event_id", "strategy_id", "symbol", "entry_ts"],
  "fields": [
    {
      "field": "price",
      "accepted_source_keys": ["cf:/price", "sheets:/price"],
      "join_keys": ["symbol", "entry_ts"],
      "temporal_rule": "nearest_observation_at_or_before_entry_ts_within_ssot_data_stale_ms"
    },
    {
      "field": "pos_pct",
      "accepted_source_keys": ["cf:/pos_pct", "sheets:/pos_pct"],
      "join_keys": ["event_id", "symbol", "entry_ts"],
      "temporal_rule": "position_snapshot_at_entry"
    },
    {
      "field": "lev",
      "accepted_source_keys": ["cf:/lev", "sheets:/lev"],
      "join_keys": ["event_id", "symbol", "entry_ts"],
      "temporal_rule": "position_snapshot_at_entry"
    },
    {
      "field": "liq_price|liq_buffer_pct",
      "accepted_source_keys": ["cf:/liq_price", "cf:/liq_buffer_pct", "sheets:/liq_price", "sheets:/liq_buffer_pct"],
      "join_keys": ["event_id", "symbol", "entry_ts"],
      "temporal_rule": "position_risk_snapshot_at_entry"
    },
    {
      "field": "funding_8h_pct",
      "accepted_source_keys": ["cf:/funding_8h_pct", "sheets:/funding_8h_pct"],
      "join_keys": ["symbol", "entry_ts"],
      "temporal_rule": "funding_snapshot_at_or_before_entry_ts_within_ssot_data_stale_ms"
    },
    {
      "field": "dd_day_pct",
      "accepted_source_keys": ["cf:/dd_day_pct", "sheets:/dd_day_pct"],
      "join_keys": ["event_id", "entry_ts"],
      "temporal_rule": "account_risk_snapshot_at_entry"
    },
    {
      "field": "dd_total_pct",
      "accepted_source_keys": ["cf:/dd_total_pct", "sheets:/dd_total_pct"],
      "join_keys": ["event_id", "entry_ts"],
      "temporal_rule": "account_risk_snapshot_at_entry"
    }
  ],
  "rules": {
    "ssot_data_stale_ms_required_at_runtime": true,
    "cross_source_conflict_action": "hold",
    "missing_join_key_action": "hold",
    "future_observation_join_forbidden": true,
    "interpolation_forbidden": true,
    "derived_liq_buffer_requires_formula_lineage": true,
    "source_key_fabrication_forbidden": true,
    "historical_value_fabrication_forbidden": true
  },
  "safety": {
    "action": "hold",
    "active_data_b_1m_mutated": false,
    "canonical_strategy_files_mutated": false,
    "formal_ledger_mutated": false,
    "runtime_registry_mutated": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED"
  }
}
