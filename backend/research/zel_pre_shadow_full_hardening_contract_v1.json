{
  "schema_version": "zel.pre_shadow.full_hardening.contract.v1",
  "goal": "Make Data B through Alpha Lap, W2, W3, portfolio risk and rollback deterministic, resumable, receipt-driven and fail-closed before Shadow.",
  "replay_durability": {
    "strategy_level_checkpoint": true,
    "input_fingerprint_required": true,
    "resume_after_interruption": true,
    "invalid_checkpoint_quarantine": true,
    "progress_units": "strategy",
    "eta_minimum_completed_units": 3,
    "atomic_terminal_files": [
      "report.json",
      "summary.json",
      "scoreboard.csv",
      "trades.jsonl.gz",
      "progress.json",
      "artifact_manifest.json",
      "terminal_receipt.json"
    ],
    "artifact_sha256_required": true,
    "single_owner_required": true,
    "current_running_v1_process_mutation_allowed": false,
    "canonical_v2_switch_gate": "CURRENT_1M_TERMINAL_OR_CURRENT_1M_FAIL"
  },
  "ordered_dag": [
    "DATA_B_TERMINAL",
    "RISK_MAIN_EFFECT",
    "EXACT25_LIVENESS_AND_REPAIR",
    "TRADE_METHOD_COVERAGE",
    "COMPONENT_MAIN_EFFECT",
    "SELECTED_INTERACTIONS",
    "STRATEGY_TOP3_BUNDLES",
    "ALPHA_LAP_CHALLENGERS",
    "W2_FORWARD",
    "W3_DURABILITY",
    "PORTFOLIO_JOINT_RISK",
    "ROLLBACK_REHEARSAL",
    "PRE_SHADOW_RELEASE"
  ],
  "dag_rules": {
    "one_ordered_stage_at_a_time": true,
    "parallelism_allowed_inside_component_main_effect": true,
    "missing_receipt": "hold",
    "unsafe_authority_receipt": "hold",
    "same_receipt_redispatch_forbidden": true,
    "legacy_four_way_post_1m_fanout_must_be_retired": true
  },
  "alpha_lap_v2": {
    "candidate_unit": "strategy_specific_full_bundle",
    "complete_lineage_hashes_required": true,
    "same_market_time_pairing_required": true,
    "same_cost_model_required": true,
    "same_risk_budget_required": true,
    "runtime_registry_write_allowed": false,
    "automatic_live_change": false,
    "promotion_threshold_source": "Z_POLICY_V3_AND_SSOT"
  },
  "execution_calibration": {
    "private_fill_values_stored_in_repository": false,
    "sanitized_receipt_only": true,
    "fee_funding_realized_pnl_supported": true,
    "slippage_latency_partial_rejection_supported_when_fields_exist": true,
    "unknown_fields_remain_unknown": true,
    "direct_runtime_application_allowed": false,
    "required_before_application": [
      "SSOT_COST_MODEL_REVIEW",
      "DATA_B_COST_STRESS",
      "W2_FORWARD",
      "W3_DURABILITY"
    ]
  },
  "component_attribution": {
    "same_opportunity_required": true,
    "same_cost_model_required": true,
    "same_risk_budget_required": true,
    "same_data_manifest_required": true,
    "zlice_direct_pnl_delta_zero": true,
    "zico_alpha_claim_forbidden": true,
    "lico_gross_alpha_claim_forbidden": true,
    "unpaired_comparison_action": "hold"
  },
  "deferred_until_shadow_prestart": [
    "VIEW_UI_PATCH",
    "TRADINGVIEW_CHART_RESTORE",
    "SHADOW_RUNTIME_BINDING"
  ],
  "failure_learning_ml_light": {
    "pre_300c_runtime_binding": false,
    "pre_300c_order_or_ledger_write": false,
    "post_300c_mode": "observer_only",
    "independent_holdout_required": true
  },
  "safety": {
    "current_1m_process_mutation": false,
    "canonical_strategy_mutation": false,
    "formal_ledger_mutation": false,
    "runtime_registry_write": false,
    "shadow_start_allowed": false,
    "paper_start_allowed": false,
    "live_enabled": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "action": "hold"
  }
}
