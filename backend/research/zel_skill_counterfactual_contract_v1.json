{
  "schema_version": "zel.skill_counterfactual.contract.v1",
  "version": "ZEL_SKILL_COUNTERFACTUAL_CONTRACT_V1",
  "state": "FROZEN_RESEARCH_ONLY",
  "rules": {
    "closed_trade_summary_may_not_synthesize_intratrade_path": true,
    "unknown_skill_requires_signal_replay": true,
    "os_guard_direct_pnl_delta_forbidden": true,
    "advisor_direct_pnl_delta_forbidden": true,
    "missing_evidence_action": "hold"
  },
  "families": [
    {
      "match_prefixes": ["SK_POS_"],
      "counterfactual_mode": "PATH_DEPENDENT_POSITION_MANAGEMENT",
      "required_evidence_any": [
        ["intratrade_price_path", "position_size_path", "timestamp_path"],
        ["bar_path", "position_size_path", "bar_timestamp_path"]
      ],
      "exact_replay_allowed_when_complete": true
    },
    {
      "match_prefixes": ["SK_EXEC_", "SK_PORT_", "SK_OPS_"],
      "counterfactual_mode": "GUARD_OR_EXECUTION_CONTEXT",
      "required_evidence_any": [],
      "exact_replay_allowed_when_complete": false,
      "parity_only": true
    },
    {
      "match_prefixes": ["SK_AI_", "SK_ADVISOR_", "SK_EXPLAIN_"],
      "counterfactual_mode": "READ_ONLY_ADVISORY",
      "required_evidence_any": [],
      "exact_replay_allowed_when_complete": false,
      "parity_only": true
    },
    {
      "match_prefixes": ["SK_STRAT_", "SK_SIGNAL_", "SK_"],
      "counterfactual_mode": "SIGNAL_REPLAY_REQUIRED",
      "required_evidence_any": [
        ["ohlcv_path", "strategy_config_sha256", "signal_source_sha256"]
      ],
      "exact_replay_allowed_when_complete": true
    }
  ],
  "safety": {
    "action": "hold",
    "active_data_b_1m_mutated": false,
    "canonical_strategy_files_mutated": false,
    "formal_ledger_mutated": false,
    "runtime_registry_mutated": false,
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED"
  }
}
