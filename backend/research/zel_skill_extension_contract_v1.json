{
  "schema_version": "zel.skill_extension.contract.v1",
  "mode": "research_only_skill_catalog_and_compatibility",
  "purpose": "Complete the missing position-management skills without duplicating Zico, Lico, Zlice, strategy-native invalidation, or portfolio-risk responsibilities.",
  "allowed_actions": [
    "reduce25",
    "partial30",
    "hold",
    "stop",
    "route_change",
    "rollback",
    "block"
  ],
  "safety": {
    "research_only": true,
    "promotion_authority": false,
    "selection_authority": false,
    "runtime_binding_allowed": false,
    "shadow_start_allowed": false,
    "paper_enabled": false,
    "live_enabled": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "canonical_strategy_files_mutated": false,
    "canonical_registry_mutated": false,
    "maximum_active_skills_per_bundle": 2,
    "maximum_add_count": 1,
    "maximum_planned_loss_r": 0.75
  },
  "existing_skill_ids": [
    "SK_ENTRY_LONG_BEAM",
    "SK_ENTRY_SHORT_BEAM",
    "SK_ADD_DCA",
    "SK_ADD_AVG_DOWN",
    "SK_ADD_WATER_ADD",
    "SK_ADD_PYRAMIDING",
    "SK_ADD_PROFITABLE_SCALE_IN",
    "SK_EXIT_PARTIAL_30",
    "SK_EXIT_TRAILING_STOP",
    "SK_EXIT_MFE_RUNNER",
    "SK_EXIT_RUNNER_HOLD",
    "SK_EXIT_TIME_STOP",
    "SK_EXIT_BREAK_EVEN_SHIFT",
    "SK_RISK_REDUCE_25"
  ],
  "new_skills": [
    {
      "skill_id": "SK_EXIT_PARTIAL_STOP_30",
      "category": "POSITION_EXIT",
      "intent": "Cut 30 percent of an adverse position after a bounded loss trigger while preserving the original hard invalidation.",
      "action": "partial30",
      "required_fields": ["realized_R", "MAE_R"],
      "counterfactual_fidelity": "EVENT_LEVEL_RESEARCH_ONLY",
      "selection_eligible_after_exact_path_replay": true,
      "observer_only": false,
      "forbidden_with": ["SK_ADD_DCA", "SK_ADD_AVG_DOWN", "SK_ADD_WATER_ADD"],
      "trigger_grid": {"adverse_mae_r": [0.35, 0.5, 0.65], "partial_pct": [30]},
      "falsification": "Reject if Net R or expectancy improves only by using terminal MAE with no causal trigger timestamp, or if DD improves while payoff and cost-adjusted EV materially deteriorate."
    },
    {
      "skill_id": "SK_EXIT_PROFIT_LOCK",
      "category": "POSITION_EXIT",
      "intent": "Lock part of an open gain after MFE expansion and a causal retracement rather than converting a winner into a loss.",
      "action": "partial30",
      "required_fields": ["realized_R", "MFE_R"],
      "counterfactual_fidelity": "EVENT_LEVEL_RESEARCH_ONLY",
      "selection_eligible_after_exact_path_replay": true,
      "observer_only": false,
      "forbidden_with": [],
      "trigger_grid": {"activation_mfe_r": [0.75, 1.0, 1.25], "lock_fraction": [0.25, 0.35, 0.5]},
      "falsification": "Reject if winner truncation lowers payoff more than DD or left-tail risk improves, or if the result depends on terminal MFE without a causal retracement path."
    },
    {
      "skill_id": "SK_RISK_VOLATILITY_REDUCE_25",
      "category": "POSITION_RISK",
      "intent": "Reduce position exposure by 25 percent when entry-time volatility is outside the strategy-specific supported regime.",
      "action": "reduce25",
      "required_fields": ["realized_R", "entry_atr_pct"],
      "counterfactual_fidelity": "ENTRY_CONTEXT_REQUIRED",
      "selection_eligible_after_exact_path_replay": true,
      "observer_only": false,
      "forbidden_with": [],
      "trigger_grid": {"entry_atr_pct": [2.5, 3.5, 5.0], "size_multiplier": [0.75]},
      "falsification": "Reject if the threshold is derived from post-entry volatility, if opportunity cost exceeds avoided loss, or if benefit is confined to one symbol/window."
    },
    {
      "skill_id": "SK_GUARD_LIQUIDATION_BUFFER",
      "category": "SAFETY_GUARD",
      "intent": "Reduce or block exposure when the liquidation buffer falls below the SSOT boundary.",
      "action": "block",
      "required_fields": ["liq_buffer_pct"],
      "counterfactual_fidelity": "OBSERVER_ONLY_UNTIL_MARGIN_PATH_EXISTS",
      "selection_eligible_after_exact_path_replay": false,
      "observer_only": true,
      "forbidden_with": [],
      "trigger_grid": {},
      "falsification": "The guard must not be scored as alpha or economic improvement; it remains a safety veto until leverage, margin, mark price and liquidation-path lineage are exact."
    },
    {
      "skill_id": "SK_EXIT_STRUCTURE_INVALIDATION",
      "category": "STRATEGY_NATIVE_EXIT",
      "intent": "Close when the original setup is causally invalidated by the strategy's own state machine.",
      "action": "stop",
      "required_fields": ["invalidation_state", "invalidation_ts"],
      "counterfactual_fidelity": "OBSERVER_ONLY_UNTIL_STRATEGY_NATIVE_LINEAGE_EXISTS",
      "selection_eligible_after_exact_path_replay": false,
      "observer_only": true,
      "forbidden_with": [],
      "trigger_grid": {},
      "falsification": "Do not replace native strategy invalidation with a generic threshold and do not score it until setup, trigger, confirmation and invalidation lineage are present."
    }
  ],
  "role_boundaries": {
    "ZICO": ["loss cooldown", "duplicate or stale order prevention", "OMS state recovery"],
    "LICO": ["spread", "slippage", "latency", "funding", "venue and liquidity quality"],
    "ZLICE": ["lineage coverage", "attribution", "negative-control verification"],
    "STRATEGY_NATIVE": ["setup invalidation", "entry semantics", "regime-specific signal state"],
    "PORTFOLIO_RISK": ["cross-strategy exposure", "family concentration", "joint drawdown", "margin conflict"]
  },
  "global_compatibility": {
    "loss_direction_adds_observer_only": ["SK_ADD_DCA", "SK_ADD_AVG_DOWN", "SK_ADD_WATER_ADD"],
    "profit_direction_adds": ["SK_ADD_PYRAMIDING", "SK_ADD_PROFITABLE_SCALE_IN"],
    "profit_direction_add_requires_unrealized_profit_and_reconfirmation": true,
    "loss_and_profit_direction_add_combination_forbidden": true,
    "partial_stop_with_loss_direction_add_forbidden": true,
    "observer_only_skill_cannot_enter_top_bundle": true,
    "one_axis_main_effect_before_pair_interaction": true,
    "zlice_economic_delta_must_equal_zero": true
  },
  "required_logger_fields": [
    "skill_applied",
    "skill_name",
    "skill_trigger_ts",
    "skill_context",
    "skill_before_entry",
    "skill_after_entry",
    "skill_cost",
    "skill_delta_r",
    "skill_exit_role"
  ],
  "roadmap": [
    "DATA_B_15M_1M_TERMINAL_AUTHORITY",
    "RISK_MAIN_EFFECT",
    "SKILL_SINGLE_MAIN_EFFECT",
    "STRATEGY_REGIME_COMPATIBILITY",
    "SELECTED_PAIR_INTERACTIONS",
    "STRATEGY_TOP3_SKILL_BUNDLES",
    "TEAM_ZBOT_LICO_ZICO_ZLICE_BUNDLE",
    "W2_FRESH_FORWARD",
    "W3_TEMPORAL_DURABILITY",
    "PORTFOLIO_CONFLICT_TEST",
    "SHADOW_20_100_200_300C",
    "PAPER_30D",
    "HUMAN_APPROVED_MICRO_LIVE"
  ]
}
