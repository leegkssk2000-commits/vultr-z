{
  "schema_version": "zel.survivor_tiering_policy.v3",
  "version": "ZEL_SURVIVOR_TIERING_V3",
  "state": "INSTALLED_PROSPECTIVE_ONLY",
  "activation": {
    "retroactive_reclassification_forbidden": true,
    "new_fresh_boundary_required_for_promotion": true,
    "existing_v2_receipts_remain_authoritative_for_their_original_boundary": true,
    "same_evidence_retune_forbidden": true
  },
  "a1_causal_alpha_gate": {
    "economics_required": {
      "minimum_net_R": 0.0,
      "minimum_expectancy_R": 0.0,
      "minimum_profit_factor": 1.0,
      "minimum_payoff_ratio": 1.0,
      "minimum_retention_pct": 60.0,
      "realistic_cost_authority_required": true,
      "integrity_required": true,
      "leakage_lookahead_max": 0
    },
    "hard_negative_controls": [
      "same_count_random_entry",
      "direction_inversion",
      "timestamp_shuffle"
    ],
    "diagnostic_controls": {
      "one_bar_delay": "TIMING_TOLERANCE_DIAGNOSTIC_NOT_AUTOMATIC_KILL",
      "indicator_removal": "FEATURE_NECESSITY_OR_SIMPLIFICATION_DIAGNOSTIC_NOT_AUTOMATIC_KILL"
    },
    "hard_control_rule": {
      "maximum_p_value": 0.05,
      "minimum_candidate_minus_control_ci_low_R": 0.0,
      "require_equal_trade_budget": true,
      "require_identical_window_and_cost_lineage": true
    },
    "a1_outputs": [
      "A1_CAUSAL_CORE_READY",
      "A1_CAUSAL_CONDITIONAL_READY",
      "A1_PARKED_STRONG",
      "A1_REJECT"
    ],
    "concentration_at_a1": "LABEL_AND_ROUTE_TO_A3_NOT_GLOBAL_KILL_UNLESS_INTEGRITY_OR_SINGLE_SOURCE_DEPENDENCE_MAKES_THE_MECHANISM_INVALID"
  },
  "a2_cost_gate": {
    "required": true,
    "reference_contract": "backend/research/prep/a2_cost_turnover_ssot_v1.json",
    "must_pass": ["1X_COST", "2X_COST", "P95_FUNDING", "PLUS_ONE_BAR", "TURNOVER"]
  },
  "a3_regime_durability_gate": {
    "required": true,
    "reference_contract": "backend/research/prep/a3_regime_taxonomy_v1.json",
    "core_requirement": "POSITIVE_AND_DURABLE_ACROSS_REQUIRED_REGIME_DECOMPOSITION_WITH_GLOBAL_H5_PASS",
    "conditional_requirement": "EXPLICIT_ENTRY_TIME_REGIME_OWNER_WITH_POSITIVE_OWNED_REGIME_ECONOMICS_AND_FAIL_CLOSED_OUTSIDE_OWNER",
    "outcome_defined_regime_forbidden": true
  },
  "final_tiers": {
    "CORE_SURVIVOR": {
      "requirements": ["A1_CAUSAL_CORE_READY", "A2_PASS", "A3_PASS", "H5_GLOBAL_PASS"],
      "shadow_eligibility": "FULL_CANDIDATE"
    },
    "CONDITIONAL_SURVIVOR": {
      "requirements": ["A1_CAUSAL_CORE_READY_OR_CONDITIONAL_READY", "A2_PASS", "A3_EXPLICIT_REGIME_OWNER_PASS"],
      "global_h5_leave_one_group_out_may_fail": true,
      "must_fail_closed_outside_owned_regime": true,
      "shadow_eligibility": "REGIME_GATED_CANDIDATE"
    },
    "PARKED_STRONG": {
      "requirements": ["POSITIVE_ECONOMICS_AND_INTEGRITY", "ONE_OR_MORE_CAUSAL_OR_SAMPLE_GATES_UNRESOLVED"],
      "shadow_eligibility": "OBSERVER_ONLY_UNTIL_REQUALIFIED"
    },
    "REJECT": {
      "requirements": ["ECONOMIC_OR_INTEGRITY_OR_CAUSAL_FAILURE"],
      "shadow_eligibility": "NONE"
    }
  },
  "h5_final_production_gate": {
    "stage": "A3_TO_FINAL_SURVIVOR",
    "maximum_single_regime_profit_share": 0.7,
    "maximum_single_symbol_profit_share": 0.7,
    "maximum_top10_trade_profit_share": 0.8,
    "minimum_leave_one_group_out_net_R": 0.0,
    "required_dimensions": ["symbol", "regime", "side", "session", "window"],
    "thresholds_must_be_sealed_before_holdout": true
  },
  "authority": {
    "selection_authority": false,
    "promotion_authority": false,
    "execution_authority": "NONE",
    "order_authority": "BLOCKED",
    "live_trade_authority": "BLOCKED",
    "protected_mutations": 0,
    "action": "hold"
  }
}
