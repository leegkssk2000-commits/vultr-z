{
  "schema": "q4r3_performance_attribution_matrix_v1",
  "status": "design_locked_not_activated",
  "principles": {
    "same_trade_join_key": ["decision_id", "position_id", "attribution_id", "counterfactual_cohort_id"],
    "single_global_leaderboard_allowed": false,
    "trading_contribution_and_operational_correctness_separated": true,
    "raw_baseline_154c_reused_for_integrated_attribution": false,
    "new_integrated_epoch_required": true
  },
  "layers": {
    "strategy": {
      "metric_family": "trading_outcome",
      "metrics": ["net_r", "expectancy_r", "win_rate_pct", "mfe_r", "mae_r", "dd_pct", "fee_r", "slippage_r"]
    },
    "method": {
      "metric_family": "trading_outcome",
      "metrics": ["net_r", "expectancy_r", "win_rate_pct", "entry_quality_r", "exit_quality_r", "false_entry_rate_pct"]
    },
    "skill": {
      "metric_family": "incremental_trading_contribution",
      "metrics": ["net_r_delta", "avoided_loss_r", "captured_mfe_r", "missed_profit_r", "trigger_precision_pct", "false_trigger_rate_pct"]
    },
    "team": {
      "metric_family": "proposal_contribution",
      "metrics": ["net_r_delta_vs_raw", "avoided_loss_r", "false_block_rate_pct", "support_challenge_value_r", "watcher_detection_value_r"]
    },
    "team_bot": {
      "metric_family": "role_ablation",
      "metrics": ["main_delta_r", "support_delta_r", "watcher_avoided_loss_r", "watcher_false_alarm_rate_pct", "helper_delta_r", "latency_ms"]
    },
    "ZBot": {
      "metric_family": "advisor_counterfactual",
      "metrics": ["net_r_delta_vs_no_zbot", "avoided_loss_r", "missed_profit_r", "false_block_rate_pct", "provider_disagreement_rate_pct", "api_cost_usd", "latency_ms"]
    },
    "Zico": {
      "metric_family": "control_correctness",
      "metrics": ["expired_lease_block_count", "duplicate_prevented_count", "race_prevented_count", "state_mismatch_count", "false_block_rate_pct", "gate_latency_ms"]
    },
    "Lico": {
      "metric_family": "execution_context_value",
      "metrics": ["slippage_delta_r", "fee_funding_prediction_error_r", "venue_degradation_detection_rate_pct", "stale_source_rate_pct", "false_degrade_rate_pct", "context_latency_ms"]
    },
    "Zlice": {
      "metric_family": "evidence_integrity",
      "metrics": ["event_coverage_pct", "outcome_join_coverage_pct", "replay_match_pct", "duplicate_event_count", "missing_parent_count", "lineage_mismatch_count", "write_latency_ms"]
    }
  },
  "zlice_role": {
    "canonical_role": "append_only_evidence_lineage_replay_and_outcome_join",
    "signal_generation_allowed": false,
    "team_vote_allowed": false,
    "final_decision_allowed": false,
    "order_authority": "none",
    "dashboard_primary_card_allowed": false,
    "read_only_consumers": ["ALIMI", "Bots", "Log", "performance_evaluator", "replay_viewer"],
    "required_events": [
      "strategy_selected", "method_selected", "skill_selected", "bot_response_emitted",
      "team_proposal_emitted", "lico_context_applied", "zbot_advice_emitted",
      "zico_lease_state_cleaned", "zico_gate_decided", "position_opened",
      "position_closed", "outcome_joined", "counterfactual_evaluated"
    ]
  }
}
