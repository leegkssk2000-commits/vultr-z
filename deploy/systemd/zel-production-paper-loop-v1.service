[Unit]
Description=ZEL Production PAPER Autonomous Loop V1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zel/apps/zel
Environment=PYTHONPATH=/home/zel/apps/zel
EnvironmentFile=-/etc/zel/production-paper-loop.env
ExecStart=/bin/bash /home/zel/apps/zel/backend/production/zel_production_paper_runner_v1.sh
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/zel/apps/zel/ledger

[Install]
WantedBy=multi-user.target
