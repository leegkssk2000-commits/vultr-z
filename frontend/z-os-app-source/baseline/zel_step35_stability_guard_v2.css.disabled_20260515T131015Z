/* ZEL Step3.5 stability guard v2: app-bound team panel + no-layout perf guard. */
html.zel-step35-stable, body.zel-step35-stable { scroll-behavior:auto !important; }
.zel-step3e-root {
  box-sizing:border-box !important;
  position:relative !important;
  left:auto !important; right:auto !important; top:auto !important; bottom:auto !important;
  transform:none !important;
  float:none !important;
  width:100% !important;
  max-width:100% !important;
  min-width:0 !important;
  margin:14px 0 !important;
  contain:layout paint !important;
  isolation:isolate !important;
}
body > .zel-step3e-root,
html > .zel-step3e-root {
  width:min(520px, calc(100vw - 24px)) !important;
  max-width:min(520px, calc(100vw - 24px)) !important;
  margin:14px auto !important;
}
.zel-step3e-root *,
.zel-step3e-modal *,
.zel-step3e-backdrop * { box-sizing:border-box !important; }
.zel-step3e-grid { width:100% !important; min-width:0 !important; }
.zel-step3e-card { min-width:0 !important; overflow:hidden !important; }
.zel-step3e-card .zel-step3e-desc,
.zel-step3e-card .zel-step3e-pill,
.zel-step3e-card .zel-step3e-mini span { overflow-wrap:anywhere !important; word-break:normal !important; }
.zel-step3e-modal { max-width:min(560px, calc(100vw - 28px)) !important; }
.zel-v6-book, .zel-btc-v8-card {
  contain:layout paint style !important;
  content-visibility:auto;
  contain-intrinsic-size:520px;
}
.zel-v6-book [class*="row"], .zel-btc-v8-card [class*="row"] { backface-visibility:hidden; }
@media (max-width:560px){
  .zel-step3e-root { margin:12px 0 !important; }
  .zel-step3e-grid { grid-template-columns:1fr !important; }
  .zel-step3e-modal { max-height:calc(100vh - 28px) !important; overflow:auto !important; }
}
