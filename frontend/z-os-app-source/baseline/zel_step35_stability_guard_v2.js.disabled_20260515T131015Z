      var r=el.getBoundingClientRect(); var area=r.width*r.height;
      if(s>bs || (s===bs && area<bestArea)){ best=el; bs=s; bestArea=area; }
    });
    return best;
  }
  function findBottomNav(host){
    if(!host) return null;
    var nodes=[]; try{ nodes=Array.prototype.slice.call(host.querySelectorAll('nav,div,section')); }catch(e){ return null; }
    var best=null, bestTop=-1;
    nodes.forEach(function(el){
      var t=text(el); if(!/Dash\s+Trade\s+Log\s+Settings\s+Bots/i.test(t)) return;
