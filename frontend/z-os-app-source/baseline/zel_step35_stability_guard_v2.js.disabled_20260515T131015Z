          }
        });
      }catch(e){ err(e); }
      try{ Object.defineProperty(P,'__zelStep35WsGuard',{value:true}); }catch(e){ P.__zelStep35WsGuard=true; }
      state.wsWrapped=true;
    }catch(e){ err(e); }
  }
  function boot(){
