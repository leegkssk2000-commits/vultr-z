          timer=0;
          if(pending){ var p=pending; pending=null; last=(performance&&performance.now)?performance.now():Date.now(); try{ fn.call(self,p); }catch(e){ setTimeout(function(){ throw e; },0); } }
        }, Math.max(16, frame-(now-last)));
