  function err(x){ try{ state.errors.push(String(x&&x.message||x).slice(0,160)); }catch(e){} }
  function text(el){ return ((el&&el.textContent)||'').replace(/\s+/g,' ').trim(); }
  function visible(el){ try{ var r=el.getBoundingClientRect(); return r.width>220 && r.height>260; }catch(e){ return false; } }
  function scoreHost(el){
    if(!el || el===document.body || el===document.documentElement || !visible(el)) return -999;
    var t=text(el); if(t.length<300) return -999;
    var r; try{ r=el.getBoundingClientRect(); }catch(e){ return -999; }
    var s=0;
    if(r.width>=300 && r.width<=760) s+=45; else if(r.width<900) s+=20; else s-=80;
    if(/Operational\s+Console/i.test(t)) s+=35;
    if(/BTCUSDT/i.test(t)) s+=20;
    if(/ETHUSDT/i.test(t) && /SOLUSDT/i.test(t)) s+=20;
    if(/Dash\s+Trade\s+Log\s+Settings\s+Bots/i.test(t)) s+=30;
    if(/ZEL\s+Team\s+System\s+Rebuild/i.test(t)) s+=10;
    if(/SOURCE\s+HOLD\s+V34/i.test(t)) s-=30;
    if(el.classList && el.classList.contains('zel-step3e-root')) s-=200;
    return s;
  }
  function findAppHost(){
    var nodes=[];
    try{ nodes=Array.prototype.slice.call(document.querySelectorAll('main,section,article,div')); }catch(e){ return null; }
    var best=null, bs=-999, bestArea=Infinity;
    nodes.forEach(function(el){
