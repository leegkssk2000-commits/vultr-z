/* ZEL Step3-E Team Rebuild V1: native team cards replaced by rebuilt read-only route panel. */
.zel-step3e-native-hidden {
  display: none !important;
  pointer-events: none !important;
  visibility: hidden !important;
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  overflow: hidden !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
}
.zel-step3e-root {
  position: relative;
  isolation: isolate;
  width: 100%;
  box-sizing: border-box;
  margin: 14px 0 4px;
  padding: 14px;
  border: 1px solid rgba(0, 221, 255, .42);
  border-radius: 20px;
  background:
    radial-gradient(circle at 16% 0%, rgba(27, 255, 221, .10), transparent 34%),
    linear-gradient(180deg, rgba(7, 24, 36, .92), rgba(5, 15, 25, .97));
  box-shadow: 0 0 0 1px rgba(0, 255, 213, .08) inset, 0 18px 48px rgba(0,0,0,.34);
  color: #e9fbff;
  font-family: inherit;
}
.zel-step3e-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:12px; }
.zel-step3e-kicker { color:#7fdcff; text-transform:uppercase; letter-spacing:.13em; font-weight:900; font-size:10px; line-height:1.2; }
.zel-step3e-title { margin-top:3px; font-size:19px; line-height:1.05; font-weight:950; color:#fff; }
.zel-step3e-sub { margin-top:5px; max-width: 420px; color:#a9dbed; font-size:12px; line-height:1.35; font-weight:700; }
.zel-step3e-mode { flex:0 0 auto; border:1px solid rgba(117,255,221,.42); border-radius:999px; padding:6px 10px; color:#65ffd5; background:rgba(0,255,213,.08); font-size:10px; font-weight:950; }
.zel-step3e-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.zel-step3e-card {
  width:100%; box-sizing:border-box; text-align:left; cursor:pointer;
  padding:14px; border-radius:16px; border:1px solid rgba(92,160,216,.38);
  background:linear-gradient(180deg, rgba(7, 22, 35, .94), rgba(3, 13, 23, .96));
  color:#e9fbff; box-shadow:0 0 0 1px rgba(255,255,255,.025) inset;
  transition:transform .12s ease, border-color .12s ease, background .12s ease;
}
.zel-step3e-card:hover { transform:translateY(-1px); border-color:rgba(0,221,255,.74); background:linear-gradient(180deg, rgba(9, 33, 49, .96), rgba(3, 13, 23, .96)); }
.zel-step3e-card:focus-visible { outline:2px solid rgba(0,255,255,.75); outline-offset:2px; }
.zel-step3e-card.is-active { border-color:rgba(0,255,170,.56); box-shadow:0 0 0 1px rgba(0,255,170,.10) inset; }
.zel-step3e-card.is-standby { border-color:rgba(255,214,66,.48); }
.zel-step3e-card.is-fallback { border-color:rgba(156,113,255,.48); }
.zel-step3e-card.is-guard { border-color:rgba(255,77,133,.48); }
.zel-step3e-cardtop { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.zel-step3e-name { font-size:17px; line-height:1.12; font-weight:950; color:#fff; }
.zel-step3e-badge { flex:0 0 auto; border:1px solid rgba(116,180,255,.44); border-radius:999px; padding:5px 8px; font-size:10px; font-weight:950; color:#bfe9ff; background:rgba(9,30,49,.78); }
.zel-step3e-card.is-active .zel-step3e-badge { border-color:rgba(0,255,170,.52); color:#5cffc8; }
.zel-step3e-card.is-standby .zel-step3e-badge { border-color:rgba(255,217,64,.55); color:#ffe46d; }
.zel-step3e-card.is-fallback .zel-step3e-badge { border-color:rgba(167,124,255,.55); color:#c5a8ff; }
.zel-step3e-card.is-guard .zel-step3e-badge { border-color:rgba(255,77,133,.60); color:#ff8bad; }
.zel-step3e-desc { margin-top:6px; color:#b8e5f4; font-size:12px; line-height:1.35; font-weight:700; }
.zel-step3e-pills { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.zel-step3e-pill { border:1px solid rgba(63,154,216,.44); border-radius:999px; padding:4px 7px; color:#b8eaff; font-size:10px; line-height:1; font-weight:900; background:rgba(2,16,27,.68); }
.zel-step3e-meta { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; }
.zel-step3e-mini { border:1px solid rgba(52,96,132,.64); border-radius:12px; padding:8px; background:rgba(0,0,0,.16); }
.zel-step3e-mini b { display:block; color:#79dcff; text-transform:uppercase; letter-spacing:.11em; font-size:9px; margin-bottom:4px; }
.zel-step3e-mini span { color:#f7fdff; font-size:12px; line-height:1.25; font-weight:850; }
.zel-step3e-footer { margin-top:11px; display:flex; align-items:center; justify-content:space-between; gap:10px; color:#83c8dc; font-size:10px; font-weight:850; }
.zel-step3e-openhint { color:#76ffd9; }
.zel-step3e-backdrop {
  position:fixed; inset:0; z-index:2147482500;
  background:rgba(1,6,12,.72); backdrop-filter:blur(7px);
}
.zel-step3e-modal {
  position:fixed; z-index:2147482501; left:50%; top:50%; transform:translate(-50%,-50%);
  width:min(620px, calc(100vw - 24px)); max-height:calc(100vh - 44px); overflow:auto;
  box-sizing:border-box; padding:16px; border-radius:22px;
  border:1px solid rgba(0,221,255,.70);
  background:
    radial-gradient(circle at 10% 0%, rgba(0,255,220,.13), transparent 36%),
    linear-gradient(180deg, rgba(5, 31, 43, .98), rgba(3, 12, 21, .98));
  box-shadow:0 26px 90px rgba(0,0,0,.72), 0 0 0 1px rgba(0,255,213,.08) inset;
  color:#edfaff; font-family:inherit;
}
.zel-step3e-modal.is-active { border-color:rgba(0,255,170,.70); }
.zel-step3e-modal.is-standby { border-color:rgba(255,214,64,.70); }
.zel-step3e-modal.is-fallback { border-color:rgba(168,126,255,.76); }
.zel-step3e-modal.is-guard { border-color:rgba(255,77,133,.76); }
.zel-step3e-mhead { display:grid; grid-template-columns:1fr auto auto; gap:12px; align-items:start; }
.zel-step3e-mkicker { color:#87e4ff; text-transform:uppercase; letter-spacing:.13em; font-size:10px; font-weight:950; }
.zel-step3e-mtitle { margin-top:4px; color:#fff; font-size:22px; line-height:1.08; font-weight:950; }
.zel-step3e-msub { margin-top:6px; color:#bddff0; font-size:12px; line-height:1.4; font-weight:750; }
.zel-step3e-score { border:1px solid rgba(255,220,75,.70); border-radius:15px; padding:9px 12px; min-width:76px; text-align:center; color:#fff49b; background:rgba(255,214,64,.10); font-weight:950; }
.zel-step3e-score small { display:block; font-size:9px; letter-spacing:.12em; text-transform:uppercase; }
.zel-step3e-score div { font-size:20px; line-height:1.05; }
.zel-step3e-close { width:34px; height:34px; border-radius:999px; border:1px solid rgba(148,192,255,.60); background:rgba(20,30,61,.80); color:#e8f6ff; font-size:23px; line-height:1; font-weight:500; cursor:pointer; }
.zel-step3e-close:hover { border-color:rgba(0,221,255,.85); color:#fff; }
.zel-step3e-mchips { display:flex; flex-wrap:wrap; gap:7px; margin:12px 0; }
.zel-step3e-mchip { border:1px solid rgba(92,170,215,.48); border-radius:999px; padding:5px 8px; color:#c8ecff; background:rgba(0,0,0,.20); font-size:10px; font-weight:900; }
.zel-step3e-mchip.is-state { color:#72ffd9; border-color:rgba(0,255,170,.55); }
.zel-step3e-mgrid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.zel-step3e-box { border:1px solid rgba(78,139,182,.45); border-radius:14px; padding:11px; background:rgba(3,16,28,.78); min-height:84px; }
.zel-step3e-box.is-gate { border-color:rgba(255,218,60,.48); }
.zel-step3e-boxtitle { color:#78ddff; letter-spacing:.11em; text-transform:uppercase; font-size:10px; font-weight:950; margin-bottom:8px; }
.zel-step3e-kv { display:grid; grid-template-columns:98px 1fr; gap:5px 10px; color:#dff7ff; font-size:12px; line-height:1.25; }
.zel-step3e-kv b { color:#8edfff; font-weight:900; }
.zel-step3e-kv span { font-weight:850; }
.zel-step3e-list { margin:0; padding:0; list-style:none; }
.zel-step3e-list li { position:relative; margin:0 0 7px 0; padding-left:14px; color:#dff7ff; font-size:12px; line-height:1.32; font-weight:750; }
.zel-step3e-list li::before { content:""; position:absolute; left:0; top:.5em; width:6px; height:6px; border-radius:50%; background:#00f6ff; box-shadow:0 0 9px rgba(0,246,255,.7); }
.zel-step3e-note { margin-top:10px; padding:10px 11px; border-radius:14px; border:1px solid rgba(0,255,213,.35); background:rgba(0,255,213,.06); color:#bdf6ed; font-size:11px; line-height:1.35; font-weight:800; }
.zel-step3e-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px; }
.zel-step3e-action { border:1px solid rgba(85,164,224,.55); border-radius:12px; background:rgba(5,20,34,.9); color:#effbff; padding:10px; font-weight:950; font-size:13px; cursor:pointer; }
.zel-step3e-action:hover { border-color:rgba(0,221,255,.85); }
@media (max-width: 560px) {
  .zel-step3e-root { padding:12px; }
  .zel-step3e-grid, .zel-step3e-meta, .zel-step3e-mgrid, .zel-step3e-actions { grid-template-columns:1fr; }
  .zel-step3e-head { flex-direction:column; }
  .zel-step3e-mhead { grid-template-columns:1fr auto; }
  .zel-step3e-score { grid-column:1/2; width:max-content; }
  .zel-step3e-close { grid-column:2; grid-row:1; }
}
