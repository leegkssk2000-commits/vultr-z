Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/z/z/.venv/bin/python -m backend.research.rebuild.economic7_canonical_history_v1 --symbols BTC-USDT ETH-USDT SOL-USDT XRP-USDT LINK-USDT DOGE-USDT --start 2026-02-13T20:36:00Z --end 2026-09-15T00:00:00Z --out /home/z/z/runtime/economic7_campaign_20260915/canonical_postgap_20260213 --max-requests 0
