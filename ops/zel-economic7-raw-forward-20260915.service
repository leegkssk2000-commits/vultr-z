[Unit]
Description=ZEL Economic7 raw BingX L2 and trade evidence capture
Wants=network-online.target
After=network-online.target
[Service]
Type=exec
WorkingDirectory=/home/z/worktrees/7core-campaign-20260915
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/z/z/.venv/bin/python -m backend.research.rebuild.economic7_bingx_raw_capture_v1 --out /home/z/z/runtime/economic7_campaign_20260915/bingx_raw_forward --symbols BTC-USDT ETH-USDT --max-seconds 0 --max-bytes 2147483648
Restart=always
RestartSec=5
RestartPreventExitStatus=2
TimeoutStopSec=15
Nice=10
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/z/z/runtime/economic7_campaign_20260915
StandardOutput=append:/home/z/z/runtime/economic7_campaign_20260915/raw_capture.log
StandardError=append:/home/z/z/runtime/economic7_campaign_20260915/raw_capture.log
[Install]
WantedBy=multi-user.target
