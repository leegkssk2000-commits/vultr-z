[Unit]
Description=Scalp7 dedicated BTC ETH trade raw evidence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/z/worktrees/scalp7-broad-v2-20260915
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/z/z/.venv/bin/python -u -m backend.research.rebuild.scalp7_trade_raw_source_v3 --out /home/z/z/runtime/scalp7_broad_v2_20260915/micro_trade_raw_clock_v3 --max-bytes 4294967296
Restart=always
RestartPreventExitStatus=2
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/z/z/runtime/scalp7_broad_v2_20260915/micro_trade_raw_clock_v3
MemoryMax=768M
Nice=10

[Install]
WantedBy=multi-user.target
