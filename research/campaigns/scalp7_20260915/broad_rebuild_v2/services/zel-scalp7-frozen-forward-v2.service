[Unit]
Description=Frozen Scalp7 V2 observed signal research
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/home/z/worktrees/scalp7-broad-v2-20260915
ExecStart=/home/z/z/.venv/bin/python -u -m backend.research.rebuild.scalp7_fresh_forward_v2 --out /home/z/z/runtime/scalp7_broad_v2_20260915/fresh_forward --config /home/z/z/runtime/scalp7_broad_v2_20260915/FRESH_FORWARD_CONFIG_V2.json
Restart=on-failure
RestartSec=30
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/z/z/runtime/scalp7_broad_v2_20260915/fresh_forward
MemoryMax=1G
UMask=0022

[Install]
WantedBy=multi-user.target
