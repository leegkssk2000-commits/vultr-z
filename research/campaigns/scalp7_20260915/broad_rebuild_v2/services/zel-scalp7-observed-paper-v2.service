[Unit]
Description=Scalp7 V2 observed quote research paper ledger
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/home/z/worktrees/scalp7-broad-v2-20260915
ExecStart=/home/z/z/.venv/bin/python -u -m backend.research.rebuild.scalp7_observed_paper_v2 --out /home/z/z/runtime/scalp7_broad_v2_20260915/observed_paper --config /home/z/z/runtime/scalp7_broad_v2_20260915/OBSERVED_PAPER_CONFIG_V2.json
Restart=on-failure
RestartSec=30
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/z/z/runtime/scalp7_broad_v2_20260915/observed_paper
MemoryMax=1G

[Install]
WantedBy=multi-user.target
