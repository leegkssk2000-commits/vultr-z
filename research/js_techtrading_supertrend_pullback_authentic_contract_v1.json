    "license": "MPL-2.0",
    "authority": "SOURCE_CODE_NOT_DESCRIPTION"
  },
  "strategy_declaration": {
    "pine_version": 5,
    "default_qty_type": "strategy.percent_of_equity",
    "default_qty_value_pct": 1.0,
    "process_orders_on_close": false,
    "pyramiding_default": 0,
    "calc_on_order_fills_default": false,
    "calc_on_every_tick_default": false,
    "use_bar_magnifier_default": false
  },
  "default_inputs": {
    "strategy_type": "Pullback",
    "atr_length": 10,
    "supertrend_factor": 3.0,
    "ema_enabled": true,
    "ema_length": 200,
    "ema_source": "close",
    "rsi_enabled": true,
    "rsi_length": 14,
    "rsi_buy_level": 50.0,
    "rsi_sell_level": 50.0,
    "start_time": "2005-01-01T00:00:00",
    "end_time": "2045-03-01T00:00:00",
    "trade_direction": "Both",
    "stop_loss_pct": 1.0,
    "take_profit_pct": 1.0
  },
  "signal_contract": {
    "supertrend": "TradingView ta.supertrend(factor=3.0, atrPeriod=10)",
    "uptrend": "direction < 0",
    "downtrend": "direction >= 0",
    "pullback_long": "ta.crossunder(low[1], uptrend_supertrend_line) AND current high > previous high",
    "pullback_short": "ta.crossover(high[1], downtrend_supertrend_line) AND current low < previous low",
    "long_filter": "close > EMA(close,200) AND RSI(close,14) >= 50",
    "short_filter": "close < EMA(close,200) AND RSI(close,14) <= 50",
    "entry_flat_only": true,
    "entry_long": "pullback_long AND long_filter AND flat AND inside_backtest_window",
    "entry_short": "pullback_short AND short_filter AND flat AND inside_backtest_window"
  },
  "execution_contract": {
    "signal_calculation": "once_at_confirmed_bar_close",
    "market_entry_fill": "next_bar_open",
    "protective_orders_created": "at_close_after_position_is_visible_to_strategy",
    "entry_bar_protection": false,
    "exit_orders": "fixed 1% stop and fixed 1% limit from average entry price",
    "supertrend_reversal_exit": false,
    "position_reversal": false,
    "same_bar_stop_take_collision": "TradingView default broker-emulator OHLC path",
    "gap_price_order_fill": "current_bar_open_when_level_crossed_in_interbar_gap",
    "terminal_force_close": false
  },
  "economic_validation": {
    "source_default_commission_pct": 0.0,
    "source_default_slippage_ticks": 0,
    "required_cost_sensitivity_bps_per_fill": [0, 2, 4, 6, 8, 10],
    "required_symbols": ["XRPUSDT", "LINKUSDT", "BTCUSDT", "ETHUSDT", "SOLUSDT"],
    "required_timeframes_minutes": [5, 15],
    "required_split": "strict_forward_OOS",
    "promotion_requires": {
      "gross_net_return_positive": true,
      "cost_4bps_net_return_positive": true,
      "profit_factor_min": 1.0,
      "positive_symbols_min": 3,
      "long_and_short_attribution_required": true,
      "no_post_selection": true
    }
  },
  "mutation_authority": {
    "legacy_parent": false,
    "existing_supertrend_flip_child": false,
    "registry": false,
    "config": false,
    "router": false,
    "service": false,
    "shadow": false,
    "paper": false,
    "live": false,
    "order": false
  }
}
