    "known_material_deviations": [
      "legacy ATR helper uses a simple rolling mean of true range instead of the official TradingView ATR RMA definition",
      "EMA50 slope, swing lookback, pullback depth, reclaim and candle filters replace flip-only entry",
      "fixed 2.4R and 3.0R targets replace opposite-flip native exit",
      "scale-in, dip-add, beam and fixed side-size logic are injected before authentic baseline edge proof",
      "short entries are generated but silently remapped to HOLD by the legacy LBot adapter",
      "no explicit opposite-flip exit or atomic reversal intent is emitted"
    ]
  },
  "authentic_child": {
    "strategy_id": "supertrend_flip_authentic",
    "parent_strategy_id": "supertrend_pullback",
    "implementation_target": "backend/strategies/authentic/supertrend_flip_authentic.py",
    "registry_target": "backend/strategy25/authentic_child_registry_v1.json",
    "implementation_allowed_in_this_stage": false,
    "purpose": "Formula-locked bidirectional Supertrend flip control baseline with no ZEL entry, exit, sizing or add logic.",
    "identity_guards": [
      "child name must not contain pullback",
      "legacy parent source must not be edited",
      "authentic child must remain inactive and fail-closed until replay gates pass",
      "no performance claim is permitted from contract verification"
    ]
  },
  "formula_contract": {
    "parameters": {
      "atr_length": 10,
      "factor": 3.0,
      "parameter_optimization_allowed": false,
      "threshold_relaxation_allowed": false,
      "parameter_change_requires_new_strategy_identity": true
    },
    "true_range": "max(high-low, abs(high-prev_close), abs(low-prev_close))",
    "atr": {
      "method": "WILDER_RMA",
      "source": "true_range",
      "seed": "SMA_OF_FIRST_ATR_LENGTH_TRUE_RANGES",
      "recurrence": "atr_t=(atr_prev*(length-1)+tr_t)/length",
      "legacy_simple_rolling_mean_allowed": false
    },
    "basic_bands": {
      "hl2": "(high+low)/2",
      "basic_upper": "hl2+factor*atr",
      "basic_lower": "hl2-factor*atr"
    },
    "recursive_final_bands": {
      "upper": "basic_upper if basic_upper<prev_final_upper or prev_close>prev_final_upper else prev_final_upper",
      "lower": "basic_lower if basic_lower>prev_final_lower or prev_close<prev_final_lower else prev_final_lower"
    },
    "direction": {
      "warmup_direction": "DOWN",
      "when_previous_supertrend_is_upper": "UP if close>final_upper else DOWN",
      "otherwise": "DOWN if close<final_lower else UP",
      "supertrend_line": "final_lower when direction=UP else final_upper",
      "decision_time": "CONFIRMED_BAR_CLOSE_ONLY"
    },
    "forbidden_formula_substitutions": [
      "EMA trend filter",
      "swing high or low filter",
      "pullback percentage",
      "reclaim threshold",
      "candle body or close-location filter",
      "ATR percentage regime filter",
      "fixed profit target",
      "fixed ATR stop order",
      "beam classification",
      "scale-in",
      "dip-add",
      "pyramiding"
    ]
  },
  "bidirectional_intent_contract": {
    "contract_id": "BidirectionalIntentContract",
    "allowed_intents": [
      "HOLD",
      "ENTER_LONG",
      "ENTER_SHORT",
      "EXIT_LONG",
      "EXIT_SHORT",
      "REVERSE_TO_LONG",
      "REVERSE_TO_SHORT"
    ],
    "silent_remap_allowed": false,
    "unsupported_intent_action": "BLOCK",
    "position_side_mismatch_action": "BLOCK",
    "reversal_accounting": {
      "execution_semantics": "ATOMIC_AT_CONFIRMED_BAR_CLOSE",
      "ledger_semantics": "TWO_LEGS_EXIT_THEN_ENTRY_WITH_SAME_SIGNAL_TS",
      "fee_application": "APPLY_TO_BOTH_LEGS_ONLY_AFTER_GROSS_EDGE_GATE"
    }
  },
  "strategy_state_contract": {
    "contract_id": "StrategyStateContract",
    "state_schema": "supertrend_flip_authentic_state_v1",
    "state_key": [
      "strategy_id",
      "symbol",
      "timeframe",
      "replay_fold_id"
    ],
    "required_state_fields": [
      "bar_close_ts",
      "atr",
      "basic_upper",
      "basic_lower",
      "final_upper",
      "final_lower",
      "supertrend_line",
      "previous_direction",
      "current_direction",
      "position_side",
      "last_flip_ts",
      "warmup_complete",
      "reset_reason"
    ],
    "states": [
      "WARMUP",
      "FLAT",
      "LONG",
      "SHORT"
    ],
    "transition_table": [
      {
        "from": "WARMUP",
        "event": "ATR_BECOMES_VALID",
        "to": "FLAT",
        "intent": "HOLD",
        "rule": "initial valid direction is state initialization and is never counted as a flip entry"
      },
      {
        "from": "FLAT",
        "event": "DIRECTION_DOWN_TO_UP",
        "to": "LONG",
        "intent": "ENTER_LONG"
      },
      {
        "from": "FLAT",
        "event": "DIRECTION_UP_TO_DOWN",
        "to": "SHORT",
        "intent": "ENTER_SHORT"
      },
      {
        "from": "LONG",
        "event": "DIRECTION_UP_TO_DOWN",
        "to": "SHORT",
        "intent": "REVERSE_TO_SHORT"
      },
      {
        "from": "SHORT",
        "event": "DIRECTION_DOWN_TO_UP",
        "to": "LONG",
        "intent": "REVERSE_TO_LONG"
      },
      {
        "from": "FLAT|LONG|SHORT",
        "event": "NO_DIRECTION_CHANGE",
        "to": "UNCHANGED",
        "intent": "HOLD"
      }
    ],
    "determinism_controls": [
      "one decision per confirmed bar close",
      "state snapshot before and after every decision",
      "no cross-symbol leakage",
      "no cross-timeframe leakage",
      "no cross-fold leakage",
      "segment boundaries inside one fold do not reset state",
      "fold boundary reset is explicit and logged"
    ]
  },
